<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:WMS.Desktop.Converters">

    <converters:GreaterThanZeroConverter x:Key="GreaterThanZero"/>

    <Style x:Key="WatermarkTextBox" TargetType="TextBox">
        <!-- базовые свойства -->
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderBrush" Value="#CCC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="FontSize" Value="14"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        IsEnabled ="True">

                        <Grid>
                            <!-- текст -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"/>

                            <!-- watermark -->
                            <TextBlock x:Name="Watermark"
                                   Text="🔍 Поиск..."
                                   Foreground="#777"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- показать watermark -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Watermark"
                                Property="Visibility"
                                Value="Visible"/>
                        </Trigger>

                        <!-- фокус -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border"
                                Property="BorderBrush"
                                Value="#4FC3F7"/>
                            <Setter TargetName="Watermark"
                                Property="Visibility"
                                Value="Collapsed"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="#333333"/>

        <Style.Triggers>

            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#1f91dc"/>
            </Trigger>

        </Style.Triggers>
    </Style>

    <Style x:Key="FilterIssuePopupStyle" TargetType="Popup">
        <Setter Property="IsOpen" Value="False"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>

                    <Condition Binding="{Binding ElementName=SearchIssue, Path=Text.Length,
                                                 Converter={StaticResource GreaterThanZero}}"
                               Value="True"/>
                    <Condition Binding="{Binding FilteredStocks.Count,
                                                 Converter={StaticResource GreaterThanZero}}"
                               Value="True"/>

                    <Condition Binding="{Binding ElementName=SearchIssue, Path=IsKeyboardFocused}"
                               Value="True"/>

                </MultiDataTrigger.Conditions>
                <Setter Property="IsOpen" Value="True"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterComponentsPopupStyle" TargetType="Popup">
        <Setter Property="IsOpen" Value="False"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>

                    <Condition Binding="{Binding ElementName=SearchComponentsToReceipt, Path=Text.Length,
                                                 Converter={StaticResource GreaterThanZero}}"
                               Value="True"/>
                    <Condition Binding="{Binding FilteredComponents.Count,
                                                 Converter={StaticResource GreaterThanZero}}"
                               Value="True"/>

                    <Condition Binding="{Binding ElementName=SearchComponentsToReceipt, Path=IsKeyboardFocused}"
                               Value="True"/>

                </MultiDataTrigger.Conditions>
                <Setter Property="IsOpen" Value="True"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterRackPopupStyle" TargetType="Popup">
        <Setter Property="IsOpen" Value="False"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    
                    <Condition Binding="{Binding ElementName=SearchRack, Path=Text.Length,
                             Converter={StaticResource GreaterThanZero}}"
                           Value="True"/>
                    
                    <Condition Binding="{Binding FilteredRacks.Count,
                             Converter={StaticResource GreaterThanZero}}"
                           Value="True"/>
                    
                    <Condition Binding="{Binding ElementName=SearchRack, Path=IsKeyboardFocused}"
                           Value="True"/>
                    
                </MultiDataTrigger.Conditions>
                <Setter Property="IsOpen" Value="True"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterCellPopupStyle" TargetType="Popup">
        <Setter Property="IsOpen" Value="False"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>

                    <Condition Binding="{Binding ElementName=SearchCell, Path=Text.Length,
                                                 Converter={StaticResource GreaterThanZero}}"
                               Value="True"/>
                    <Condition Binding="{Binding FilteredFreeCells.Count,
                                                 Converter={StaticResource GreaterThanZero}}"
                               Value="True"/>
                    
                    <Condition Binding="{Binding ElementName=SearchCell, Path=IsKeyboardFocused}"
                               Value="True"/>

                </MultiDataTrigger.Conditions>
                <Setter Property="IsOpen" Value="True"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TextBoxStyle" TargetType="TextBox">
        <Setter Property="Tag" Value="5"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" 
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>