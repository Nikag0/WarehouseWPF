<Window x:Class="WMS.Desktop.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WMS.Desktop.Views"
        mc:Ignorable="d"
        Title="SettingsView" Height="450" Width="800">

    <Grid Background="#36495b">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Список операторов" 
                   Style="{StaticResource WindowNames}"
                   Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding FilteredItemsToReceipt}" 
                  AutoGenerateColumns="False" 
                  FontSize="15" 
                  IsReadOnly="True" 
                  RowHeight="40"
                  Margin="0,0,0,10">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Фамилия" Width="150" Binding="{Binding Article}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                <DataGridTextColumn Header="Имя" Width="50*" Binding="{Binding ComponentName}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                <DataGridTextColumn Header="Отчество" Width="50*" Binding="{Binding Manufacturer}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                <DataGridTemplateColumn Width="150" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Изменить"
                                    Command="{Binding DataContext.AddItemToReceiptCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource ButtonStyle}"
                                    FontSize="13"
                                    Margin="3">
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="150" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Удалить"
                                    Command="{Binding DataContext.AddItemToReceiptCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource ButtonStyle}"
                                    FontSize="13"
                                    Margin="3">
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" 
                   Text="Каталог" 
                   Style="{StaticResource WindowNames}"
                   Margin="0,0,0,10"/>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding FilteredComponents}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  FontSize="15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="150*"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="400*"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="300*"/>
                <DataGridTemplateColumn Width="150" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Изменить"
                     Command="{Binding DataContext.AddItemToReceiptCommand,
                     RelativeSource={RelativeSource AncestorType=DataGrid}}"
                     CommandParameter="{Binding}"
                     Style="{StaticResource ButtonStyle}"
                     FontSize="13"
                     Margin="3">
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="150" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Удалить"
                     Command="{Binding DataContext.AddItemToReceiptCommand,
                     RelativeSource={RelativeSource AncestorType=DataGrid}}"
                     CommandParameter="{Binding}"
                     Style="{StaticResource ButtonStyle}"
                     FontSize="13"
                     Margin="3">
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>

</Window>
