<Window x:Class="WMS.Desktop.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WMS.Desktop.Views"
        mc:Ignorable="d"
        Title="SettingsView" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#36495b">

        <TabControl Margin="10" Background="Transparent" BorderThickness="0">

            <!-- Вкладка Каталог -->
            <TabItem Header="Каталог" FontSize="16">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Каталог" Style="{StaticResource WindowNames}" Margin="0,0,0,10"/>

                    <Button Grid.Row="1" Content="Добавить запись" 
                    Command="{Binding AddComponentCommand}" 
                    HorizontalAlignment="Left" Width="150" Margin="0,0,0,10" Style="{StaticResource ButtonStyle}"/>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredComponents}" AutoGenerateColumns="False" IsReadOnly="True" FontSize="15" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="150*"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="400*"/>
                            <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="300*"/>
                            <DataGridTemplateColumn Width="150" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Изменить" 
                                        Command="{Binding DataContext.EditComponentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Style="{StaticResource ButtonStyle}" FontSize="13" Margin="3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="150" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Удалить" 
                                        Command="{Binding DataContext.DeleteComponentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Style="{StaticResource ButtonStyle}" FontSize="13" Margin="3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка Операторы -->
            <TabItem Header="Операторы" FontSize="16">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Список операторов" Style="{StaticResource WindowNames}" Margin="0,0,0,10"/>

                    <Button Grid.Row="1" Content="Добавить запись" 
                    Command="{Binding AddOperatorCommand}" 
                    HorizontalAlignment="Left" Width="150" Margin="0,0,0,10" Style="{StaticResource ButtonStyle}"/>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredOperators}" AutoGenerateColumns="False" FontSize="15" IsReadOnly="True" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Фамилия" Width="150" Binding="{Binding Surname}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                            <DataGridTextColumn Header="Имя" Width="50*" Binding="{Binding Name}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                            <DataGridTextColumn Header="Отчество" Width="50*" Binding="{Binding Patronymic}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                            <DataGridTemplateColumn Width="150" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Изменить" 
                                        Command="{Binding DataContext.EditOperatorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Style="{StaticResource ButtonStyle}" FontSize="13" Margin="3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="150" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Удалить" 
                                        Command="{Binding DataContext.DeleteOperatorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Style="{StaticResource ButtonStyle}" FontSize="13" Margin="3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>

</Window>
