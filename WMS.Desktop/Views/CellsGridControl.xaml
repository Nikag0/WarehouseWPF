<UserControl x:Class="WMS.Desktop.Views.CellsGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views"
             xmlns:converters="clr-namespace:WMS.Desktop.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        
        <converters:RackTypeToVisibilityConverter x:Key="RackTypeToVisibilityConverter"/>   
        <converters:RackImageConverter x:Key="RackImageConverter"/>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid MaxHeight="450" MaxWidth="300">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="19*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="11*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="1" Grid.Row="0"
              Visibility="{Binding RackType, RelativeSource={RelativeSource AncestorType=UserControl},
                                   Converter={StaticResource RackTypeToVisibilityConverter},
                                   ConverterParameter=R1}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Style="{StaticResource HeaderTextStyle}" Text="1"/>
            <TextBlock Grid.Column="1" Style="{StaticResource HeaderTextStyle}" Text="2"/>
            <TextBlock Grid.Column="2" Style="{StaticResource HeaderTextStyle}" Text="3"/>
            
        </Grid>

        <Grid Grid.Column="1" Grid.Row="0"
              Visibility="{Binding RackType, RelativeSource={RelativeSource AncestorType=UserControl},
                                   Converter={StaticResource RackTypeToVisibilityConverter},
                                   ConverterParameter=R2}">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Style="{StaticResource HeaderTextStyle}" Text="1"/>
            <TextBlock Grid.Column="1" Style="{StaticResource HeaderTextStyle}" Text="2"/>
            <TextBlock Grid.Column="2" Style="{StaticResource HeaderTextStyle}" Text="3"/>
            <TextBlock Grid.Column="3" Style="{StaticResource HeaderTextStyle}" Text="4"/>
        </Grid>

        <Grid Grid.Column="1" Grid.Row="0"
              Visibility="{Binding RackType, RelativeSource={RelativeSource AncestorType=UserControl},
                                   Converter={StaticResource RackTypeToVisibilityConverter},
                                   ConverterParameter=R3}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource HeaderTextStyle}" Text="1"/>
            <TextBlock Grid.Column="1" Style="{StaticResource HeaderTextStyle}" Text="2"/>
            <TextBlock Grid.Column="2" Style="{StaticResource HeaderTextStyle}" Text="3"/>
        </Grid>

        <Grid Grid.Column="0" Grid.Row="1"
            Visibility="{Binding RackType, RelativeSource={RelativeSource AncestorType=UserControl},
                           Converter={StaticResource RackTypeToVisibilityConverter},
                           ConverterParameter=R3}">
            <Grid.RowDefinitions>
                <RowDefinition Height="12"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="1" Text="А"
                HorizontalAlignment="Center" 
                Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="3" Text="Б"
                HorizontalAlignment="Center" 
                Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="5" Text="В" 
                HorizontalAlignment="Center" 
                Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="7" Text="Г"
                HorizontalAlignment="Center" 
                Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="9" Text="Д" 
                HorizontalAlignment="Center" 
                Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="11" Text="Е" 
                HorizontalAlignment="Center" 
                Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="13" Text="Ж" 
                HorizontalAlignment="Center" 
                Style="{StaticResource HeaderTextStyle}"/>

        </Grid>

        <Grid Grid.Column="0" Grid.Row="1"
            Visibility="{Binding RackType, RelativeSource={RelativeSource AncestorType=UserControl},
                   Converter={StaticResource RackTypeToVisibilityConverter},
                   ConverterParameter=R2}">
            <Grid.RowDefinitions>
                <RowDefinition Height="12"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="1" Text="А"
        HorizontalAlignment="Center" 
        Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="3" Text="Б"
        HorizontalAlignment="Center" 
        Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="5" Text="В" 
        HorizontalAlignment="Center" 
        Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="7" Text="Г" 
        HorizontalAlignment="Center" 
        Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="9" Text="Д" 
        HorizontalAlignment="Center" 
        Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="11" Text="Е" 
        HorizontalAlignment="Center" 
        Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="13" Text="Ж"
        HorizontalAlignment="Center" 
        Style="{StaticResource HeaderTextStyle}"/>

        </Grid>

        <Grid Grid.Column="0" Grid.Row="1"
    Visibility="{Binding RackType, RelativeSource={RelativeSource AncestorType=UserControl},
                   Converter={StaticResource RackTypeToVisibilityConverter},
                   ConverterParameter=R1}">
            <Grid.RowDefinitions>
                <RowDefinition Height="12"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6.6*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="1" Text="А"
        HorizontalAlignment="Center" 
        Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="3" Text="Б"
        HorizontalAlignment="Center" 
        Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="5" Text="В"
        HorizontalAlignment="Center" 
        Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="7" Text="Г"
        HorizontalAlignment="Center" 
        Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="9" Text="Д"
        HorizontalAlignment="Center" 
        Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="11" Text="Е"
        HorizontalAlignment="Center" 
        Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Grid.Row="13" Text="Ж"
        HorizontalAlignment="Center" 
        Style="{StaticResource HeaderTextStyle}"/>

        </Grid>

        <Viewbox Grid.Column="1"
                 Grid.Row="1"
                 Stretch="Fill">

            <Grid Width="800" Height="1200">

                <Image Source="{Binding SelectedRack.Type, Converter={StaticResource RackImageConverter}}"
                       Stretch="Fill"/>

                <ItemsControl ItemsSource="{Binding Cells, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding Width}"
                                    Height="{Binding Height}">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="LightBlue"/>
                                                <Setter Property="BorderThickness" Value="10"/>
                                            </DataTrigger>
                                            
                                            <DataTrigger Binding="{Binding ItemInCell}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource WarehouseStockHighlightBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                        
                                    </Style>
                                </Border.Style>

                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                                      Command="{Binding DataContext.SelectCellCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
            
        </Viewbox>
        
    </Grid>
</UserControl>
