<Window x:Class="WMS.Desktop.Views.Settings.DeleteConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WMS.Desktop.Views.Settings"
        mc:Ignorable="d"
        Title="DeleteConfirmationWindow" Height="330" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#36495b"
        ResizeMode="NoResize">
    
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Style="{StaticResource WindowNames}" Margin="0,0,0,20" FontSize="18">
            <Run Text="Для подтверждения введите текст ниже:"/>
            <LineBreak/>
            <Run Text="{Binding ExpectedConfirmationText, Mode=OneWay}" FontWeight="Bold"/>
        </TextBlock>

        <TextBox Grid.Row="1" Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,10"/>

        <CheckBox Grid.Row="2"
                  IsChecked="{Binding IsExportBeforeDelete}"
                  VerticalAlignment="Top"
                  Margin="0,5,0,0"
                  Foreground="White"
                  FontSize="14"
                  Content="Сохранить удаляемую историю в CSV"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Удалить"  
                    Command="{Binding ConfirmCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                    Width="100" Height="30" Margin="0,0,10,0" Style="{StaticResource ButtonStyle}"/>
            
            <Button Content="Отменить" IsCancel="True" Width="100" Height="30" Style="{StaticResource ButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
