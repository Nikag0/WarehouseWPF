<Window x:Class="WMS.Desktop.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="1000" Height="760" MinWidth="850" MinHeight="450"
        FontSize="{StaticResource BodyFontSize}"
        WindowStartupLocation="CenterOwner" Background="#36495b">
    <Window.Resources>
        <Style x:Key="SettingsSection" TargetType="Border">
            <Setter Property="Background" Value="#465C70"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SettingsHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource SectionTitleFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Настройки"
                   Style="{StaticResource WindowNames}" Margin="0,0,0,14"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Добавить оператора"
                                    Command="{Binding AddOperatorCommand}" Style="{StaticResource ButtonStyle}"/>
                            <TextBlock Text="Операторы" Style="{StaticResource SettingsHeading}"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding FilteredOperators}" AutoGenerateColumns="False" FontSize="{StaticResource BodyFontSize}" IsReadOnly="True" RowHeight="40" ColumnHeaderHeight="38" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Фамилия" Width="*" Binding="{Binding Surname}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                                <DataGridTextColumn Header="Имя" Width="*" Binding="{Binding Name}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                                <DataGridTextColumn Header="Отчество" Width="*" Binding="{Binding Patronymic}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                                <DataGridTemplateColumn Width="150" IsReadOnly="False" CellStyle="{StaticResource DataGridActionCell}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Изменить"
                                            Command="{Binding DataContext.EditOperatorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ButtonStyle}" Margin="3"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="150" IsReadOnly="False" CellStyle="{StaticResource DataGridActionCell}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Удалить"
                                            Command="{Binding DataContext.DeleteOperatorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ButtonStyle}" Margin="3"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <TextBlock Text="Работа с записями" Style="{StaticResource SettingsHeading}" Margin="0,0,0,14"/>
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Content="Экспортировать CSV"
                                    Command="{Binding ExportStockCsvCommand}" Style="{StaticResource ButtonStyle}"/>
                            <TextBlock Text="Таблица наличия товаров" Foreground="White" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Separator Margin="0,0,0,12"/>
                        <TextBlock Text="Очистка истории за период" Foreground="White" Margin="0,0,0,8"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Очистить историю" Foreground="#A12632"
                                    Command="{Binding DeleteHistoryCommand}" Style="{StaticResource ButtonStyle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="С" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Padding="2" CornerRadius="4" BorderThickness="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DateFromInvalid}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FF8D96"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DatePicker Width="155" SelectedDate="{Binding DateFrom}"
                                                Style="{StaticResource LargeCalendarDatePicker}"/>
                                </Border>
                                <TextBlock Text="По" Foreground="White" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                <Border Padding="2" CornerRadius="4" BorderThickness="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DateToInvalid}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FF8D96"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DatePicker Width="155" SelectedDate="{Binding DateTo}"
                                                Style="{StaticResource LargeCalendarDatePicker}"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding DateRangeError}" Foreground="#FFB9BF"
                                   TextWrapping="Wrap" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DateRangeError}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <TextBlock Text="Подсветка стеллажей" Style="{StaticResource SettingsHeading}" Margin="0,0,0,14"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Перезагрузить"
                                    Command="{Binding ReinitializeControllersCommand}" Style="{StaticResource ButtonStyle}"/>
                            <TextBlock Text="Перезагружает подсветку на стеллажах"
                                       Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>