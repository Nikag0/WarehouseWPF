<Window x:Class="WMS.Desktop.Views.ComponentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="{Binding WindowTitle}" Width="440" SizeToContent="Height"
        FontSize="{StaticResource BodyFontSize}" WindowStartupLocation="CenterOwner"
        Background="#36495b" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding WindowTitle}" Foreground="White"
                   FontSize="{StaticResource SectionTitleFontSize}" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,14"/>

        <Label Content="Артикул" Target="{Binding ElementName=ArticleInput}" Foreground="White" Padding="0,0,0,4"/>
        <TextBox x:Name="ArticleInput" Text="{Binding Article, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12" Height="34" Padding="8,0" VerticalContentAlignment="Center"/>

        <Label Content="Название" Target="{Binding ElementName=NameInput}" Foreground="White" Padding="0,0,0,4"/>
        <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12" Height="34" Padding="8,0" VerticalContentAlignment="Center"/>

        <Label Content="Производитель" Target="{Binding ElementName=ManufacturerInput}" Foreground="White" Padding="0,0,0,4"/>
        <TextBox x:Name="ManufacturerInput" Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12" Height="34" Padding="8,0" VerticalContentAlignment="Center"/>

        <Label Content="Минимальный остаток" Target="{Binding ElementName=MinimumInput}" Foreground="White" Padding="0,0,0,4"/>
        <xctk:DecimalUpDown x:Name="MinimumInput" Value="{Binding MinQuantity, UpdateSourceTrigger=PropertyChanged}"
                            FormatString="0.###" Minimum="0" Height="34" Padding="8,0" VerticalContentAlignment="Center"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Отменить" IsCancel="True" MinWidth="120" Height="40"
                    Margin="0,0,10,0" Style="{StaticResource ButtonStyle}"/>
            <Button Content="Сохранить" Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    MinWidth="120" Height="40" Style="{StaticResource ButtonStyle}"/>
        </StackPanel>
    </StackPanel>
</Window>
