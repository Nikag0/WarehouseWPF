<UserControl x:Class="WMS.Desktop.Views.MenuView.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views"
             mc:Ignorable="d" 
             d:DesignHeight="1008" d:DesignWidth="1920">

    <UserControl.Resources>
        <Style x:Key="HistoryCalendarStyle" TargetType="Calendar">
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="2" ScaleY="2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10"
       Background="#36495b">

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="История операций"
                   Style="{StaticResource WindowNames}"/>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45*"/>
                <ColumnDefinition Width="17*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="17*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="17*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Margin="0,5,5,5"
                         Tag="Товар, оператор или комментарий"
                         Style="{StaticResource SearchTextBox}"
                         Text="{Binding SearchHistory, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Grid.Column="1" Margin="5" MinWidth="145" MaxWidth="170"
                          ItemsSource="{Binding RackOptions}" SelectedItem="{Binding SelectedRack}"
                          VerticalContentAlignment="Center"
                          AutomationProperties.Name="Стеллаж"/>

                <ComboBox Grid.Column="2" Margin="5" MinWidth="125" MaxWidth="155"
                          ItemsSource="{Binding CellOptions}" SelectedItem="{Binding SelectedCell}"
                          VerticalContentAlignment="Center"
                          AutomationProperties.Name="Ячейка"/>
            </Grid>

            <ComboBox Grid.Column="1" 
                      ItemsSource="{Binding Type}"
                      Tag="Операция:"
                      SelectedItem="{Binding SelectedOperationType}"
                      Margin="5"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Center">
            </ComboBox>

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Text="От:"
                Foreground="White"
                FontSize="{StaticResource BodyFontSize}"/>

            <DatePicker
                Grid.Column="3"
                Margin="0,0,5,0"
                Height="35" 
                FontSize="{StaticResource BodyFontSize}"
                VerticalContentAlignment="Center"
                HorizontalAlignment="Stretch"
                CalendarStyle="{StaticResource HistoryCalendarStyle}"
                SelectedDate="{Binding DateFrom}">
            </DatePicker>

            <TextBlock
                Grid.Column="4"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Text="До:"
                Foreground="White"
                FontSize="{StaticResource BodyFontSize}"/>

            <DatePicker
                Grid.Column="5"
                Height="35" 
                FontSize="{StaticResource BodyFontSize}"
                VerticalContentAlignment="Center"
                CalendarStyle="{StaticResource HistoryCalendarStyle}"
                SelectedDate="{Binding DateTo}"/>

        </Grid>

        <Grid Grid.Row="2"
              Width="300"
              HorizontalAlignment="Left"
              Margin="0,0,0,10">
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,5,0,0">
            
            <DataGrid ItemsSource="{Binding History}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      FontSize="{StaticResource BodyFontSize}"
                      RowHeight="30"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding OccurredAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="100*" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                    <DataGridTextColumn Header="Тип операции" MinWidth="150" Binding="{Binding Type}" Width="50*" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                    <DataGridTextColumn Header="Название товара" Binding="{Binding ComponentName}" Width="150*" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                    <DataGridTextColumn Header="Место хранения" Binding="{Binding RackAndCellName}" Width="100*" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                    <DataGridTextColumn Header="Было" Binding="{Binding PreviousQuantity, StringFormat={}{0:0.###}}" Width="50*" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                    <DataGridTextColumn Header="Изменения" MinWidth="115" Binding="{Binding QuantityChanged}" Width="50*" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                    <DataGridTextColumn Header="Стало" Binding="{Binding NewQuantity, StringFormat={}{0:0.###}}" Width="50*" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                    <DataGridTextColumn Header="Оператор" Binding="{Binding Operator}" Width="100*" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                    <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="100*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <!-- Обрезка текста в самой таблице, если он не влезает -->
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>

                                <!-- Настройка всплывающей подсказки -->
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip MaxWidth="400">
                                            <TextBlock Text="{Binding Comment}" TextWrapping="Wrap"/>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
