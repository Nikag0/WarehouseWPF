<UserControl x:Class="WMS.Desktop.Views.MenuView.NotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views.MenuView"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <ListBox Grid.Row="1" 
                 ItemsSource="{Binding NotificationItems}" 
                 HorizontalContentAlignment="Stretch"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.Style>
                <Style TargetType="ListBox">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <!-- Если элементов нет, скрываем ListBox и показываем текст -->
                        <Trigger Property="HasItems" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" 
                            CornerRadius="6" 
                            Margin="10,0,10,0" 
                            Padding="15,10"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <!-- Кнопки действий -->
                            </Grid.ColumnDefinitions>

                            <!-- 1. Зеленый кружок (показывается, только если IsNew == true) -->
                            <!-- Для управления видимостью используется конвертер, либо триггер -->
                            <Ellipse Grid.Column="0" 
                                     Width="8" Height="8" 
                                     Fill="#4CAF50" 
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"></Ellipse>

                            <TextBlock Grid.Column="1" 
                                       Text="⚠️" 
                                       FontSize="20" 
                                       Margin="0,0,12,0" 
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" 
                                           FontWeight="SemiBold" 
                                           FontSize="14" 
                                           Foreground="#333333"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Description}" 
                                           FontSize="12" 
                                           Foreground="#666666" 
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" 
                                        Orientation="Horizontal" 
                                        VerticalAlignment="Center" 
                                        Margin="10,0,0,0">

                                <!-- Кнопка "Прочитано" -->
                                <!--<Button Content="👁️" 
                                        Width="32" Height="32" 
                                        Margin="0,0,5,0"
                                        ToolTip="Отметить как просмотренное"
                                        Command="{Binding DataContext.MarkAsReadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>

                                --><!-- Кнопка "Удалить" --><!--
                                <Button Content="❌" 
                                        Width="32" Height="32" 
                                        Background="#FFEAEA" 
                                        Foreground="#D32F2F"
                                        ToolTip="Удалить безвозвратно"
                                        Command="{Binding DataContext.DeleteNotificationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>-->
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Новых уведомлений нет"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="25"
               Foreground="#999999">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NotificationItems.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

    </Grid>
</UserControl>
