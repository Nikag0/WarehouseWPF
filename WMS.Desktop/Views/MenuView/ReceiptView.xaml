<UserControl x:Class="WMS.Desktop.Views.MenuView.ReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views"
             xmlns:viewmodels="clr-namespace:WMS.Desktop.ViewModels.MenuViewModels" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ReceiptViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="1008"
             d:DesignWidth="1920"
             PreviewMouseDown="Root_PreviewMouseDown">

    <UserControl.Resources>
        <Style x:Key="LocationSearchTextBox" TargetType="TextBox" BasedOn="{StaticResource SearchTextBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Outline" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <DockPanel Margin="8,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource ClearSearchButton}"/>
                                <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Tag}"
                                           Foreground="#737373" VerticalAlignment="Center" Margin="0,0,5,0"
                                           IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="#4FC3F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LocationOption" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DCEAF5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellSearchTextBox" TargetType="TextBox" BasedOn="{StaticResource LocationSearchTextBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedRack}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10"
          Background="#36495b">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="189"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Приём товаров" 
                       Style="{StaticResource WindowNames}"/>

            <Grid Grid.Row="1"
                  Margin="0,5,10,5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Tag="Артикул, название или производитель"
                         Style="{StaticResource SearchTextBox}"
                         Text="{Binding SearchStockOrComponent, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Нажатая кнопка — искать только в месте, выбранном в форме приёмки -->
                <ToggleButton Grid.Column="1"
                              Content="Стеллаж"
                              IsChecked="{Binding IsRackFilterOn}"
                              ToolTip="Искать только в выбранном стеллаже"
                              Style="{StaticResource FilterToggleStyle}"
                              Margin="5,0,0,0"/>

                <ToggleButton Grid.Column="2"
                              Content="Ячейка"
                              IsChecked="{Binding IsCellFilterOn}"
                              ToolTip="Искать только в выбранной ячейке"
                              Style="{StaticResource FilterToggleStyle}"
                              Margin="5,0,0,0"/>
            </Grid>

            <Grid Grid.Row="2">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="13*"/>
                    <ColumnDefinition Width="44*"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="ReceiptSearchGrid"
                          ItemsSource="{Binding FilteredStocksOrComponents}"
                          Grid.ColumnSpan="2"
                          AutoGenerateColumns="False" 
                          FontSize="{StaticResource BodyFontSize}"
                          IsReadOnly="True" 
                          RowHeight="40"
                          Margin="0,5,10,5">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Артикул" Width="150*" MinWidth="110" Binding="{Binding Article}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                        <DataGridTextColumn Header="Название" Width="50*" MinWidth="150" Binding="{Binding ComponentName}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                        <DataGridTextColumn Header="Производитель" Width="50*" MinWidth="150" Binding="{Binding Manufacturer}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                        <DataGridTextColumn Header="Стеллаж" Width="90*" MinWidth="90" Binding="{Binding RackCodeDisplay}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                        <DataGridTextColumn Header="Ячейка" Width="90*" MinWidth="90" Binding="{Binding CellCodeDisplay}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                        <DataGridTextColumn Header="Кол-во" Width="80*" MinWidth="80" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                        <DataGridTemplateColumn Width="110*" IsReadOnly="False" CellStyle="{StaticResource DataGridActionCell}" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Добавить"
                                        Command="{Binding DataContext.AddItemToReceiptCommand,
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ButtonStyle}"
                                        FontSize="{StaticResource BodyFontSize}"
                                        Margin="3">
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.ColumnSpan="2"
                           Text="Это список товаров на складе&#10;Введите в строку поиска артикул, название или производителя&#10;Для фильтрации по месту хранения выберите фильтры «Стеллаж» и «Ячейка»"
                           Foreground="#666666"
                           FontSize="{StaticResource BodyFontSize}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="24,24,34,24"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=ReceiptSearchGrid}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                
            </Grid>

            <Grid Grid.Row="3">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4,5*"/>
                    <ColumnDefinition Width="5,5*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0"
                      Grid.Column="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="63"/>
                        <RowDefinition Height="63"/>
                        <RowDefinition Height="63"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0"
                             Style="{StaticResource InputTextBoxStockStyle}"
                             Text="{Binding ReceiptItem.Article}" 
                             AcceptsReturn="True" 
                             Tag="Артикул:"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,5,5,5"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="2"
                             BorderBrush="White"
                             IsEnabled="False"/>

                    <TextBox Grid.Row="1"
                             Style="{StaticResource InputTextBoxStockStyle}"
                             Text="{Binding ReceiptItem.ComponentName}" 
                             AcceptsReturn="True" 
                             Tag="Название:"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                              Margin="0,5,5,5"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="2"
                             BorderBrush="White"
                             IsEnabled="False"/>
                             
                     <TextBox Grid.Row="2"
                              Style="{StaticResource InputTextBoxStockStyle}"
                              Text="{Binding ReceiptItem.Manufacturer}" 
                              AcceptsReturn="True" 
                              Tag="Производитель:"
                              TextWrapping="Wrap"
                              VerticalScrollBarVisibility="Auto"
                               Margin="0,5,5,5"
                              Background="Transparent"
                              Foreground="White"
                              BorderThickness="2"
                              BorderBrush="White"
                              IsEnabled="False"/>

                </Grid>

                <Grid Grid.Row="0"
                      Grid.Column="1">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>

                    <Grid.Resources>
                        <!-- Пока товар не выбран, количество, оператора и комментарий заполнить нельзя.
                             Стеллаж выбирать можно: с кнопкой «Стеллаж» у поля поиска с него начинается поиск товара. -->
                        <Style x:Key="RequiresComponent" TargetType="Grid">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReceiptItem.ComponentId}" Value="00000000-0000-0000-0000-000000000000">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3.3*"/>
                            <ColumnDefinition Width="3.3*"/>
                            <ColumnDefinition Width="3.3*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">

                            <TextBox x:Name="SearchRack" 
                                     GotKeyboardFocus="SearchRack_GotKeyboardFocus"
                                     PreviewKeyDown="SearchRack_PreviewKeyDown"
                                     Grid.Column="0"
                                     Margin="5,5,5,5"
                                     IsTabStop="False"
                                     Style="{StaticResource LocationSearchTextBox}"
                                     Tag="Стеллаж:"
                                     Text="{Binding SearchRacks, UpdateSourceTrigger=PropertyChanged}"
                                     TextAlignment="Center"/>
                        </Grid>

                        <Popup x:Name="RackPopup"
                               PlacementTarget="{Binding ElementName=SearchRack}" 
                               IsOpen="{Binding IsRackPopupOpen}"
                               Placement="Bottom" 
                               AllowsTransparency="True"
                               StaysOpen="True"
                               HorizontalOffset="0"
                               VerticalOffset="2">

                            <Border Background="White" 
                                    BorderBrush="#DDD" 
                                    BorderThickness="1" 
                                    Width="{Binding ElementName=SearchRack, Path=ActualWidth}">
                                
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                                </Border.Effect>

                                <ListBox ItemsSource="{Binding FilteredRacks}"
                                         ItemContainerStyle="{StaticResource WarehouseListItemStyle}"
                                            HorizontalContentAlignment="Stretch" BorderThickness="0"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource LocationOption}">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.SelectRackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <TextBlock Text="{Binding Code}" FontSize="{StaticResource BodyFontSize}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>

                        <Grid Grid.Column="1"
                              Grid.ColumnSpan="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchCell"
                                 Grid.Column="0"
                                 GotKeyboardFocus="SearchCell_GotKeyboardFocus"
                                 PreviewKeyDown="SearchCell_PreviewKeyDown"
                                 Margin="5,5,5,5"
                                 Tag="Ячейка:"
                                 IsTabStop="False"
                                 Style="{StaticResource CellSearchTextBox}"
                                 Text="{Binding SearchCell, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center"/>

                        <Popup x:Name="CellPopup"
                               PlacementTarget="{Binding ElementName=SearchCell}" 
                               IsOpen="{Binding IsCellPopupOpen}"
                               Placement="Bottom" 
                               AllowsTransparency="True"
                               StaysOpen="True"
                               HorizontalOffset="0"
                               VerticalOffset="2">

                            <Border Background="White" 
                                    BorderBrush="#DDD" 
                                    BorderThickness="1" 
                                    Width="{Binding ElementName=SearchCell, Path=ActualWidth}">
                                
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                                </Border.Effect>

                                <ListBox ItemsSource="{Binding FilteredCells}"
                                         ItemContainerStyle="{StaticResource WarehouseListItemStyle}"
                                         HorizontalContentAlignment="Stretch" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource LocationOption}">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.SelectCellCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <TextBlock Text="{Binding Code}" FontSize="{StaticResource BodyFontSize}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                
                            </Border>
                        </Popup>

                        <Border Grid.Column="1"
                                Height="Auto"
                                Margin="5,5,10,5"
                                CornerRadius="4,0,0,4"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                Background="White"
                                ClipToBounds="True">

                            <Grid Style="{StaticResource RequiresComponent}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Watermark"
                                           Grid.Column="0"
                                           Text="кол-во:" 
                                           Foreground="#777"
                                           FontSize="{StaticResource BodyFontSize}"
                                           Margin="8,0,0,0" 
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>

                                <xctk:DecimalUpDown Grid.Column="1"
                                                    Value="{Binding ReceiptItem.OperationQuantity}"
                                                    FormatString="0.###"
                                                    Minimum="0"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Padding="8,0,0,0"
                                                    FontSize="{StaticResource BodyFontSize}"
                                                    ButtonSpinnerWidth="35"
                                                    VerticalContentAlignment="Center"
                                />
                            </Grid>
                        </Border>

                        </Grid>

                    </Grid>

                    <Grid Grid.Row="1"
                          Grid.RowSpan="2"
                          Style="{StaticResource RequiresComponent}">

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <ComboBox Grid.Row="0"
                              Margin="5,5,10,5"
                              ItemsSource="{Binding Operators}"
                              SelectedItem="{Binding OperatorName}"
                              Tag="ФИО оператора:"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                        
                    <TextBox Grid.Row="1"
                             Text="{Binding CommentText}"
                             AcceptsReturn="True" 
                             Tag="Комментарий:"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="5,5,10,5"/>
                    </Grid>

                </Grid>

            </Grid>

            <Button FontSize="{StaticResource EmphasisFontSize}" Grid.Row="4"
                    Command="{Binding ReceiveCommand}"
                    Style="{StaticResource ButtonStyle}"
                    Content="Принять товар"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="0,5,10,0">
            </Button>

        </Grid>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>

            <local:RacksGridControl x:Name="RacksGrid"
                                    Grid.Row="0"
                                    Racks="{Binding RacksGrid}" />

            <local:CellsGridControl Grid.Row="1"
                                    Cells="{Binding CellsGrid}"
                                    RackType="{Binding SelectedRack.Type}"
                                    SelectedCell="{Binding SelectedCell}"
                                    Margin="0,5,0,0"/>
        </Grid>

    </Grid>
</UserControl>
