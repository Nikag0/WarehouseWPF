<UserControl x:Class="WMS.Desktop.Views.MenuView.IssueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views" 
             xmlns:viewmodels="clr-namespace:WMS.Desktop.ViewModels.MenuViewModels" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             d:DataContext="{d:DesignInstance Type=viewmodels:IssueViewModel}"
             mc:Ignorable="d" 
             d:DesignWidth="1920"
             d:DesignHeight="1008"
             PreviewMouseDown="Root_PreviewMouseDown">


    <Grid Margin="10"
          Background="#36495b">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="143"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Выдача товаров"
                       Style="{StaticResource WindowNames}"/>

            <Grid Grid.Row="1"
                  x:Name="IssueSearchPanel"
                  Margin="0,5,10,5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchToIssue" 
                         GotKeyboardFocus="SearchToIssue_GotKeyboardFocus"
                         PreviewKeyDown="SearchToIssue_PreviewKeyDown"
                         Grid.Column="0"
                         Tag="Артикул, название или производитель"
                         Text="{Binding SearchStock, UpdateSourceTrigger=PropertyChanged}"
                         IsTabStop="False">

                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource SearchTextBox}">
                            <Setter Property="IsEnabled" Value="True"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIssue}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>

                        </Style>
                    </TextBox.Style>

                </TextBox>

                <ToggleButton Grid.Column="1"
                              Content="Стеллаж"
                              IsChecked="{Binding IsRackFilterOn}"
                              ToolTip="Искать только в выбранном стеллаже"
                              Style="{StaticResource FilterToggleStyle}"
                              Margin="5,0,0,0"/>

                <ToggleButton Grid.Column="2"
                              Content="Ячейка"
                              IsChecked="{Binding IsCellFilterOn}"
                              ToolTip="Искать только в выбранной ячейке"
                              Style="{StaticResource FilterToggleStyle}"
                              Margin="5,0,0,0"/>

                <Popup x:Name="IssuePopup"
                       PlacementTarget="{Binding ElementName=SearchToIssue}" 
                       IsOpen="{Binding IsIssuePopupOpen}"
                       Placement="Bottom" 
                       AllowsTransparency="True"
                       StaysOpen="True"
                       HorizontalOffset="0"
                       VerticalOffset="2">

                    <Border Background="White"
                        BorderBrush="#617C94"
                        BorderThickness="2"
                        Padding="3"
                        Width="{Binding ElementName=IssueSearchPanel, Path=ActualWidth}"
                        MaxHeight="350">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                        </Border.Effect>

                        <ListBox ItemsSource="{Binding FilteredStocks}"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ItemContainerStyle="{StaticResource WarehouseListItemStyle}"
                                 FontSize="{StaticResource BodyFontSize}"
                                 HorizontalContentAlignment="Stretch"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="White">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#CBD8E3" BorderThickness="0,0,0,1">
                                        <Grid Margin="8,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding ComponentName}"
                                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run Text="Артикул: "/><Run Text="{Binding Article, Mode=OneWay}"/>
                                                    <Run Text=" · Производитель: "/><Run Text="{Binding Manufacturer, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run Text="Стеллаж: "/><Run Text="{Binding RackCodeDisplay, Mode=OneWay}"/>
                                                    <Run Text=" · Ячейка: "/><Run Text="{Binding CellCodeDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="Добавить к выдаче"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.AddIssueItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ButtonStyle}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

            </Grid>

            <Grid Grid.Row="2"
                  Margin="0,5,10,5">

                <DataGrid x:Name="IssueGrid" 
                          ItemsSource="{Binding IssueItems}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          FontSize="{StaticResource BodyFontSize}"
                          RowHeight="40">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Артикул" Width="150*" MinWidth="110" Binding="{Binding Stock.Article}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                        <DataGridTextColumn Header="Название" Width="50*" MinWidth="150" Binding="{Binding Stock.ComponentName}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                        <DataGridTextColumn Header="Производитель" Width="50*" MinWidth="150" Binding="{Binding Stock.Manufacturer}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                        <DataGridTextColumn Header="Стеллаж" Width="80*" MinWidth="80" Binding="{Binding Stock.RackCodeDisplay}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                        <DataGridTextColumn Header="Ячейка" Width="80*" MinWidth="80" Binding="{Binding Stock.CellCodeDisplay}" ElementStyle="{StaticResource TextDataInDataGrid}"/>
                        <DataGridTextColumn Header="Кол-во" Width="80*" MinWidth="80" Binding="{Binding Stock.Quantity, StringFormat={}{0:0.###}}" ElementStyle="{StaticResource TextDataInDataGrid}"/>

                        <DataGridTemplateColumn x:Name="QuantityColumn" Header="К выдаче" Width="110*" IsReadOnly="False" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <xctk:DecimalUpDown Value="{Binding OperationQuantity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                        UpdateValueOnEnterKey="False"
                                                        FormatString="0.###"
                                                        Minimum="0">
                                        <xctk:DecimalUpDown.Style>
                                            <Style TargetType="xctk:DecimalUpDown">
                                                <Setter Property="IsEnabled" Value="True"/>
                                                <Setter Property="ButtonSpinnerWidth" Value="45"/>
                                                <Setter Property="ButtonSpinnerHeight" Value="35"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsIssue, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </xctk:DecimalUpDown.Style>
                                    </xctk:DecimalUpDown>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="145" CellStyle="{StaticResource DataGridActionCell}">

                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Удалить всё" 
                                            Width="Auto" 
                                            Height="Auto" 
                                            Command="{Binding DataContext.ClearIssueItemsCommand, 
                                                               RelativeSource={RelativeSource 
                                                               AncestorType=DataGrid}}"
                                            Style="{StaticResource ButtonStyle}"/>
                                    
                                </StackPanel>
                            </DataGridTemplateColumn.Header>

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Удалить"
                                        Command="{Binding DataContext.RemoveIssueItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        FontSize="{StaticResource BodyFontSize}"
                                        Margin="3">
                                        
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
                                                <Setter Property="IsEnabled" Value="True"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsIssue, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Это список товаров для выдачи&#10;Введите в строку поиска артикул, название или производителя&#10;Для фильтрации по месту хранения выберите фильтры «Стеллаж» и «Ячейка»"
                           Foreground="#666666"
                           FontSize="{StaticResource BodyFontSize}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="24"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=IssueGrid}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Content="Очистить список выдачи"
                        Command="{Binding ClearIssueItemsCommand}"
                        FontSize="{StaticResource BodyFontSize}"
                        Height="50"
                        VerticalAlignment="Bottom"
                        Margin="10"
                        Foreground="White"
                        Background="#4FC3F7">

                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIssue}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </Grid>

            <Grid Grid.Row="3">

                <Grid.RowDefinitions>
                    <RowDefinition Height="63"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIssue}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Operators}"
                              Tag="ФИО оператора:"
                              SelectedItem="{Binding OperatorName}"
                              Margin="0,5,5,5"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        
                    </ComboBox>

                    <TextBox Grid.Column="1"
                             Text="{Binding CommentText}"
                             Tag="Комментарий:"
                             FontSize="{StaticResource BodyFontSize}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="5,5,10,5"/>

                </Grid>

                <Button Grid.Row="1"
                        Content="Начать выдачу" 
                        Command="{Binding IssueCommand}"
                        Style="{StaticResource ButtonStyle}"
                        FontSize="{StaticResource EmphasisFontSize}"
                        Margin="0,5,10,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
                
            </Grid>

        </Grid>

        <Grid Grid.Column="1">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>

            <local:RacksGridControl x:Name="RacksGrid"
                                    Grid.Row="0"
                                    Racks="{Binding RacksGrid}" 
                                    SelectedRack="{Binding SelectedRack}"
                                    Margin="0,0,0,5"/>

            <local:CellsGridControl Grid.Row="1"
                                    Cells="{Binding CellsGrid}"
                                    RackType="{Binding SelectedRack.Type}"
                                    SelectedCell="{Binding SelectedCell}"
                                    Margin="0,5,0,0"/>
        </Grid>

    </Grid>

</UserControl>
