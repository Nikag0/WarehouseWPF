<UserControl x:Class="WMS.Desktop.Views.ReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views" 
             xmlns:converters="clr-namespace:WMS.Desktop.Converters"
             xmlns:viewmodels="clr-namespace:WMS.Desktop.ViewModels" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             d:DataContext="{d:DesignInstance Type=viewmodels:ReceiptViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="1008"
             d:DesignWidth="1920">

    <UserControl.Resources>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:GreaterThanZeroConverter x:Key="GreaterThanZero"/>
    </UserControl.Resources>


    <Grid Margin="10,0">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition Height="400"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Приём заказов" 
                       FontSize="30" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Center"
                       Foreground="White"/>

            <Grid Grid.Row="1">

                <TextBox x:Name="SearchReceipt" Grid.Column="0" Margin="0,10" IsTabStop="False"
                     Style="{StaticResource WatermarkTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <Popup 
                         PlacementTarget="{Binding ElementName=SearchReceipt}" 
                         Tag="{Binding ElementName=SearchReceipt}"
                         Style="{StaticResource FilterReceiptPopupStyle}"
                         Placement="Bottom" 
                         AllowsTransparency="True"
                         StaysOpen="True"
                         HorizontalOffset="0"
                         VerticalOffset="2">

                    <Border Background="White" 
                         BorderBrush="#DDD" 
                         BorderThickness="1" 
                         Width="{Binding ElementName=SearchReceipt, Path=ActualWidth}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                        </Border.Effect>

                        <ListBox ItemsSource="{Binding FilteredComponents}"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">

                                        <TextBlock Text="Название: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding ComponentName}" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="  Артикул: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding Article}" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="  Производитель: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding Manufacturer}" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="    " FontSize="14" VerticalAlignment="Bottom"/>
                                        <Button Content="Добавить к приёмке"
                                            Command="{Binding DataContext.AddSelectedComponentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, 
                                                 Path=IsMouseOver}" 
                                                 Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

            </Grid>
            
            <Grid Grid.Row="2">

                <DataGrid ItemsSource="{Binding Stocks}" 
                      AutoGenerateColumns="False" 
                      FontSize="15" 
                      IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Артикул" Width="150" Binding="{Binding Article}"/>
                        <DataGridTextColumn Header="Название" Width="250" Binding="{Binding ComponentName}"/>
                        <DataGridTextColumn Header="Ячейка" Width="83" Binding="{Binding CellCode}"/>
                        <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}"/>
                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Добавить к приёмке"
                                        Command="{Binding DataContext.AddToReceiptCommand,
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Height="20"
                                        FontSize="12">
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="3">

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                            Grid.Column="0"
                            Text="Артикул" 
                            FontSize="15"
                            Foreground="White" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>

                <TextBox Grid.Row="0"
                            Grid.Column="1" 
                            Text="{Binding ItemToReceipt.Article}" 
                            Margin="5"
                            FontSize="15"
                            IsReadOnly="True" 
                            VerticalContentAlignment="Center"
                            TextAlignment="Center"/>

                <TextBlock Grid.Row="1"
                            Grid.Column="0" 
                            Text="Название" 
                            FontSize="15"
                            Foreground="White" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>

                <TextBox Grid.Row="1"
                         Grid.Column="1" 
                         Text="{Binding ItemToReceipt.ComponentName}"  
                         Margin="5" 
                         IsReadOnly="True" 
                         VerticalContentAlignment="Center" 
                         FontSize="15"
                         TextAlignment="Center"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Text="Производитель" 
                           Foreground="White" 
                           FontSize="15"/>

                <TextBox Grid.Row="2"
                         Grid.Column="1" 
                         Text="{Binding ItemToReceipt.Manufacturer}" 
                         Margin="5"  
                         IsReadOnly="True" 
                         VerticalContentAlignment="Center" 
                         FontSize="15"
                         TextAlignment="Center"/>

                <Grid Grid.Row="3"
                      Grid.Column="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Text="Стеллаж" 
                        Foreground="White" 
                        FontSize="15"/>

                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding Racks}"
                              DisplayMemberPath="RackCode"
                              SelectedItem="{Binding SelectedRack}"
                              Foreground="Black" 
                              Margin="10"
                              FontSize="15"/>

                    <TextBlock Grid.Column="2" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Text="Ячейка" 
                               Foreground="White" 
                               FontSize="15"/>

                    <Grid Grid.Column="3"
                          Margin="5">

                        <TextBox x:Name="SearchCell" 
                                 IsTabStop="False"
                                 Style="{StaticResource WatermarkTextBox}"
                                 Text="{Binding SearchFreeCell, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center"/>

                        <Popup PlacementTarget="{Binding ElementName=SearchCell}" 
                            Tag="{Binding ElementName=SearchCell}"
                            Style="{StaticResource FilterCellPopupStyle}"
                            Placement="Bottom" 
                            AllowsTransparency="True"
                            StaysOpen="True"
                            HorizontalOffset="0"
                            VerticalOffset="2">

                            <Border Background="White" 
                            BorderBrush="#DDD" 
                            BorderThickness="1" 
                            Width="{Binding ElementName=SearchCell, Path=ActualWidth}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                                </Border.Effect>

                                <ListBox ItemsSource="{Binding FilteredFreeCells}"
                               BorderThickness="0"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="5">
                                                <TextBlock Text="{Binding Code}" FontSize="14" VerticalAlignment="Bottom"/>
                                                <TextBlock Text="    " FontSize="14" VerticalAlignment="Bottom"/>
                                                <Button Content="Выбрать ячейку"
                                                    Command="{Binding DataContext.AddSelectedCellCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, 
                                                                    Path=IsMouseOver}" 
                                                                    Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>    
                    </Grid>

                </Grid>

                <Grid Grid.Row="3"
                      Grid.Column="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Margin="2" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Text="Количество" 
                               Foreground="White" 
                               FontSize="15"/>      

                    <xctk:IntegerUpDown Grid.Column="1"
                                        Value="{Binding ItemToReceipt.Quantity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        Margin="5"
                                        FontSize="15"
                                        TextAlignment="Center">
                    </xctk:IntegerUpDown>
                    
                </Grid>

                <Grid Grid.Row="5"
                      Grid.Column="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="ФИО оператора" 
                               Foreground="White"
                               FontSize="15" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Operators}"
                              SelectedItem="{Binding OperatorName}"
                              DisplayMemberPath="FullName"
                              FontSize="20"
                              HorizontalContentAlignment="Center" 
                              VerticalContentAlignment="Center"
                              Margin="5"/>

                </Grid>
                
                <Button Grid.Row="5" 
                        Grid.Column="1"
                        Command="{Binding ReceiveCommand}"
                        Content="Приёмка" 
                        Margin="5"/>
                
            </Grid>
            
        </Grid>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <Image Source="/Images/Warehouse.png" 
              Width="auto" 
              Height="auto"
              Stretch="Fill"/>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="55*"/>
                        <RowDefinition Height="5*"/>
                        <RowDefinition Height="38*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                    Grid.RowSpan="3">

                        <ItemsControl ItemsSource="{Binding NormalRacks}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="10*"/>
                                            <RowDefinition Height="17*"/>
                                            <RowDefinition Height="10*"/>
                                            <RowDefinition Height="17*"/>
                                            <RowDefinition Height="5.5*"/>
                                            <RowDefinition Height="9.5*"/>
                                            <RowDefinition Height="17*"/>
                                            <RowDefinition Height="10*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="21*"/>
                                            <ColumnDefinition Width="29.5*"/>
                                            <ColumnDefinition Width="21*"/>
                                            <ColumnDefinition Width="21*"/>
                                            <ColumnDefinition Width="6*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style>
                                    <Setter Property="Grid.Row" Value="{Binding Row}"/>
                                    <Setter Property="Grid.Column" Value="{Binding RackNum}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Gray"
                                        BorderThickness="1"
                                        MouseLeftButtonDown="RackBorder_MouseLeftButtonDown">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ItemToReceipt.SelectedRack, 
                                                                                   RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                 Value="{Binding}">
                                                        <Setter Property="Background" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                    <Grid Grid.Row="1">

                        <ItemsControl ItemsSource="{Binding SpecialRacks}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="8.6*"/>
                                            <ColumnDefinition Width="16.6*"/>
                                            <ColumnDefinition Width="16.6*"/>
                                            <ColumnDefinition Width="16.6*"/>
                                            <ColumnDefinition Width="16.6*"/>
                                            <ColumnDefinition Width="28*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style>
                                    <Setter Property="Grid.Column" Value="{Binding RackNum}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Gray"
                          BorderThickness="1"
                          MouseLeftButtonDown="RackBorder_MouseLeftButtonDown">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHighlightedReceipt}" Value="True">
                                                        <Setter Property="Background" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </Grid>

                    <!--<Grid Grid.Row="2" 
                    Grid.Column="5"
                    Margin="0,0,3,0">
                  <Rectangle 
                      Stroke="Gray" 
                      StrokeThickness="1"
                      Fill="LightGray" />

                  <TextBlock 
                      Text="👤" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center" 
                      FontSize="20" 
                      Foreground="Black"/>
              </Grid>-->

                </Grid>

            </Grid>

            <Grid Grid.Row="1">

                <Grid x:Name="Row1Grid"
             Visibility="Visible">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="13*"/>
                        <RowDefinition Height="73*"/>
                        <RowDefinition Height="13*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36*"/>
                        <ColumnDefinition Width="27*"/>
                        <ColumnDefinition Width="36*"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="1"
                  Grid.Row="1"
                  Source="/Images/Row2.jpg" 
                  Width="auto" 
                  Height="auto"
                  Stretch="Fill"/>

                    <Grid Grid.Column="1"
                 Grid.Row="1">

                        <ItemsControl ItemsSource="{Binding VisibleCells}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="13*"/>
                                            <RowDefinition Height="13.5*"/>
                                            <RowDefinition Height="13.5*"/>
                                            <RowDefinition Height="13.5*"/>
                                            <RowDefinition Height="13*"/>
                                            <RowDefinition Height="13*"/>
                                            <RowDefinition Height="13*"/>
                                            <RowDefinition Height="4.5*"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="25*"/>
                                            <ColumnDefinition Width="25*"/>
                                            <ColumnDefinition Width="25*"/>
                                            <ColumnDefinition Width="25*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style>
                                    <Setter Property="Grid.Row" Value="{Binding Line}"/>
                                    <Setter Property="Grid.Column" Value="{Binding Column}"/>
                                    <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Gray"
                                      BorderThickness="1"
                                      MouseLeftButtonDown="RackBorder_MouseLeftButtonDown">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ItemToReceipt.SelectedCell, 
                                                                                   RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                 Value="{Binding}">
                                                        <Setter Property="Background" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                </Grid>

                <Grid x:Name="Row2Grid"
                Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="13*"/>
                        <RowDefinition Height="73*"/>
                        <RowDefinition Height="13*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36*"/>
                        <ColumnDefinition Width="27*"/>
                        <ColumnDefinition Width="36*"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="1"
                     Grid.Row="1"
                     Source="/Images/Row1.jpg" 
                     Width="auto" 
                     Height="auto"
                     Stretch="Fill"/>

                    <Grid Grid.Column="1"
                    Grid.Row="1">

                        <ItemsControl ItemsSource="{Binding VisibleCells}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="2*"/>
                                            <RowDefinition Height="13*"/>
                                            <RowDefinition Height="13.5*"/>
                                            <RowDefinition Height="13.5*"/>
                                            <RowDefinition Height="13.5*"/>
                                            <RowDefinition Height="13*"/>
                                            <RowDefinition Height="13*"/>
                                            <RowDefinition Height="13*"/>
                                            <RowDefinition Height="4.5*"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.5*"/>
                                            <ColumnDefinition Width="33*"/>
                                            <ColumnDefinition Width="33*"/>
                                            <ColumnDefinition Width="33*"/>
                                            <ColumnDefinition Width="0.5*"/>
                                        </Grid.ColumnDefinitions>

                                    </Grid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style>
                                    <Setter Property="Grid.Row" Value="{Binding Line}"/>
                                    <Setter Property="Grid.Column" Value="{Binding Column}"/>
                                    <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Gray"
                                        BorderThickness="1"
                                        MouseLeftButtonDown="RackBorder_MouseLeftButtonDown">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ItemToReceipt.SelectedCell, 
                                                                                   RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                 Value="{Binding}">
                                                        <Setter Property="Background" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                </Grid>

                <Grid x:Name="Row3Grid"
                Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="13*"/>
                        <RowDefinition Height="73*"/>
                        <RowDefinition Height="13*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36*"/>
                        <ColumnDefinition Width="27*"/>
                        <ColumnDefinition Width="36*"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="1"
                     Grid.Row="1"
                     Source="/Images/Row3.jpg" 
                     Width="auto" 
                     Height="auto"
                     Stretch="Fill"/>

                    <Grid Grid.Column="1"
                    Grid.Row="1">

                        <ItemsControl ItemsSource="{Binding VisibleCells}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="2*"/>
                                            <RowDefinition Height="11*"/>
                                            <RowDefinition Height="11.5*"/>
                                            <RowDefinition Height="11.5*"/>
                                            <RowDefinition Height="12*"/>
                                            <RowDefinition Height="13*"/>
                                            <RowDefinition Height="16*"/>
                                            <RowDefinition Height="15*"/>
                                            <RowDefinition Height="7*"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*"/>
                                            <ColumnDefinition Width="90*"/>
                                            <ColumnDefinition Width="5*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style>
                                    <Setter Property="Grid.Row" Value="{Binding Line}"/>
                                    <Setter Property="Grid.Column" Value="{Binding Column}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Gray"
                                      BorderThickness="1"
                                      MouseLeftButtonDown="RackBorder_MouseLeftButtonDown">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ItemToReceipt.SelectedCell, 
                                                                                   RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                 Value="{Binding}">
                                                        <Setter Property="Background" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                </Grid>

            </Grid>

        </Grid>

    </Grid>
</UserControl>
