<UserControl x:Class="WMS.Desktop.Views.ReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views" 
             xmlns:converters="clr-namespace:WMS.Desktop.Converters"
             xmlns:viewmodels="clr-namespace:WMS.Desktop.ViewModels" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             d:DataContext="{d:DesignInstance Type=viewmodels:ReceiptViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="1008"
             d:DesignWidth="1920">

    <UserControl.Resources>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:GreaterThanZeroConverter x:Key="GreaterThanZero"/>
    </UserControl.Resources>


    <Grid Margin="10,0">

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition Height="400"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Приём заказов" 
                       FontSize="30" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Center"
                       Foreground="White"/>

            <Grid Grid.Row="1">

                <TextBox x:Name="SearchReceipt" Grid.Column="0" Margin="0,10" IsTabStop="False"
                     Style="{StaticResource WatermarkTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <Popup 
                         PlacementTarget="{Binding ElementName=SearchReceipt}" 
                         Tag="{Binding ElementName=SearchReceipt}"
                         Style="{StaticResource FilterReceiptPopupStyle}"
                         Placement="Bottom" 
                         AllowsTransparency="True"
                         StaysOpen="True"
                         HorizontalOffset="0"
                         VerticalOffset="2">

                    <Border Background="White" 
                         BorderBrush="#DDD" 
                         BorderThickness="1" 
                         Width="{Binding ElementName=SearchReceipt, Path=ActualWidth}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                        </Border.Effect>

                        <ListBox ItemsSource="{Binding FilteredComponents}"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">

                                        <TextBlock Text="Название: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding ComponentName}" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="  Артикул: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding Article}" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="  Производитель: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding Manufacturer}" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="    " FontSize="14" VerticalAlignment="Bottom"/>
                                        <Button Content="Добавить к приёмке"
                                            Command="{Binding DataContext.AddSelectedComponentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, 
                                                 Path=IsMouseOver}" 
                                                 Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

            </Grid>
            
            <Grid Grid.Row="2">

                <DataGrid ItemsSource="{Binding Stocks}" 
                      AutoGenerateColumns="False" 
                      FontSize="15" 
                      IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Артикул" Width="150" Binding="{Binding Article}"/>
                        <DataGridTextColumn Header="Название" Width="250" Binding="{Binding ComponentName}"/>
                        <DataGridTextColumn Header="Ячейка" Width="83" Binding="{Binding CellCode}"/>
                        <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="3">

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                            Grid.Column="0"
                            Text="Артикул" 
                            FontSize="15"
                            Foreground="White" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>

                <TextBox Grid.Row="0"
                            Grid.Column="1" 
                            Text="{Binding ItemToReceipt.Article}" 
                            Margin="5"
                            FontSize="15"
                            IsReadOnly="True" 
                            VerticalContentAlignment="Center"
                            TextAlignment="Center"/>

                <TextBlock Grid.Row="1"
                            Grid.Column="0" 
                            Text="Название" 
                            FontSize="15"
                            Foreground="White" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>

                <TextBox Grid.Row="1"
                         Grid.Column="1" 
                         Text="{Binding ItemToReceipt.ComponentName}"  
                         Margin="5" 
                         IsReadOnly="True" 
                         VerticalContentAlignment="Center" 
                         FontSize="15"
                         TextAlignment="Center"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Text="Производитель" 
                           Foreground="White" 
                           FontSize="15"/>

                <TextBox Grid.Row="2"
                         Grid.Column="1" 
                         Text="{Binding ItemToReceipt.Manufacturer}" 
                         Margin="5"  
                         IsReadOnly="True" 
                         VerticalContentAlignment="Center" 
                         FontSize="15"
                         TextAlignment="Center"/>

                <Grid Grid.Row="3"
                      Grid.Column="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Text="Стеллаж" 
                        Foreground="White" 
                        FontSize="15"/>

                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding Racks}"
                              DisplayMemberPath="Code"
                              SelectedItem="{Binding SelectedRacks}"
                              Foreground="Black" 
                              Margin="10"
                              FontSize="15"/>

                    <TextBlock Grid.Column="2" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Text="Ячейка" 
                               Foreground="White" 
                               FontSize="15"/>

                    <Grid Grid.Column="3"
                          Margin="5">

                        <TextBox x:Name="SearchCell" 
                                 IsTabStop="False"
                                 Style="{StaticResource WatermarkTextBox}"
                                 Text="{Binding SearchFreeCell, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center"/>

                        <Popup PlacementTarget="{Binding ElementName=SearchCell}" 
                            Tag="{Binding ElementName=SearchCell}"
                            Style="{StaticResource FilterCellPopupStyle}"
                            Placement="Bottom" 
                            AllowsTransparency="True"
                            StaysOpen="True"
                            HorizontalOffset="0"
                            VerticalOffset="2">

                            <Border Background="White" 
                            BorderBrush="#DDD" 
                            BorderThickness="1" 
                            Width="{Binding ElementName=SearchCell, Path=ActualWidth}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                                </Border.Effect>

                                <ListBox ItemsSource="{Binding FilteredFreeCells}"
                               BorderThickness="0"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="5">
                                                <TextBlock Text="{Binding Code}" FontSize="14" VerticalAlignment="Bottom"/>
                                                <TextBlock Text="    " FontSize="14" VerticalAlignment="Bottom"/>
                                                <Button Content="Выбрать ячейку"
                                               Command="{Binding DataContext.AddSelectedCellCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                               CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, 
                                                               Path=IsMouseOver}" 
                                                               Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>    
                    </Grid>

                </Grid>

                <Grid Grid.Row="3"
                      Grid.Column="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Margin="2" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Text="Количество" 
                               Foreground="White" 
                               FontSize="15"/>      

                    <xctk:IntegerUpDown Grid.Column="1"
                                        Value="{Binding ItemToReceipt.Quantity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        Margin="5"
                                        FontSize="15"
                                        TextAlignment="Center">
                    </xctk:IntegerUpDown>
                    
                </Grid>

                <Grid Grid.Row="5"
                      Grid.Column="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="ФИО оператора" 
                               Foreground="White"
                               FontSize="15" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Operators}"
                              SelectedItem="{Binding OperatorName}"
                              DisplayMemberPath="FullName"
                              FontSize="20"
                              HorizontalContentAlignment="Center" 
                              VerticalContentAlignment="Center"
                              Margin="5"/>

                </Grid>
                
                <Button Grid.Row="5" 
                        Grid.Column="1"
                        Command="{Binding ReceiveCommand}"
                        Content="Приёмка" 
                        Margin="5"/>
                
            </Grid>
            
        </Grid>

    </Grid>
</UserControl>
