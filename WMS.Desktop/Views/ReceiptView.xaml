<UserControl x:Class="WMS.Desktop.Views.ReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views"
             xmlns:converters="clr-namespace:WMS.Desktop.Converters"
             xmlns:viewmodels="clr-namespace:WMS.Desktop.ViewModels" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ReceiptViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="1008"
             d:DesignWidth="1920"
             PreviewMouseDown="Root_PreviewMouseDown">

    <UserControl.Resources>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:GreaterThanZeroConverter x:Key="GreaterThanZero"/>
    </UserControl.Resources>

    <Grid Margin="10,0">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition Height="250"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Приём товаров" 
                       FontSize="30" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Center"
                       Foreground="White"/>

            <Grid Grid.Row="1">

                <TextBox x:Name="SearchToReceipt" 
                         Grid.Column="0"
                         Margin="0,10" 
                         IsTabStop="False"
                         Style="{StaticResource WatermarkTextBox}"
                         Text="{Binding SearchtemsToReceipt, UpdateSourceTrigger=PropertyChanged}"/>

            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="13*"/>
                    <ColumnDefinition Width="44*"/>
                </Grid.ColumnDefinitions>

                <DataGrid ItemsSource="{Binding FilteredItemsToReceipt}" 
                          AutoGenerateColumns="False" 
                          FontSize="15" 
                          IsReadOnly="True" Grid.ColumnSpan="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Артикул" Width="150" Binding="{Binding Article}"/>
                        <DataGridTextColumn Header="Название" Width="50*" Binding="{Binding ComponentName}"/>
                        <DataGridTextColumn Header="Производитель" Width="50*" Binding="{Binding Manufacturer}"/>
                        <DataGridTextColumn Header="Стеллаж" Width="80" Binding="{Binding RackCodeDisplay}"/>
                        <DataGridTextColumn Header="Ячейка" Width="80" Binding="{Binding CellCodeDisplay}"/>
                        <DataGridTextColumn Header="Остаток" Width="150" Binding="{Binding Quantity}"/>
                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Добавить к приёмке"
                                        Command="{Binding DataContext.AddItemToReceiptCommand,
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Height="20"
                                        FontSize="12">
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="3">

                <Grid.RowDefinitions>
                    <RowDefinition Height="8*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0"
                      Grid.Column="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="7.5*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Артикул" 
                               FontSize="15"
                               Foreground="White" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="1" 
                               Text="{Binding ReceiptItem.Article}" 
                               Foreground="White" 
                               Margin="5"
                               FontSize="25"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0" 
                               Text="Название" 
                               FontSize="15"
                               Foreground="White" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="1" 
                               Text="{Binding ReceiptItem.ComponentName}"  
                               Foreground="White" 
                               Margin="5" 
                               FontSize="25"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Text="Производитель" 
                               Foreground="White" 
                               FontSize="15"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="1" 
                               Text="{Binding ReceiptItem.Manufacturer}"
                               Foreground="White" 
                               Margin="5"  
                               FontSize="25"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Grid>

                <Grid Grid.Row="0"
                      Grid.Column="1">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.5*"/>
                        <ColumnDefinition Width="7*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReceiptItem.ComponentId}" Value="00000000-0000-0000-0000-000000000000">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Background" Value="Gray"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>


                        <TextBlock Grid.Column="0" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Text="Стеллаж" 
                                   Foreground="White" 
                                   FontSize="15"/>

                        <TextBox x:Name="SearchRack" 
                                 GotKeyboardFocus="SearchRack_GotKeyboardFocus"
                                 PreviewKeyDown="SearchRack_PreviewKeyDown"
                                 Grid.Column="1"
                                 Margin="5"
                                 IsTabStop="False"
                                 Style="{StaticResource WatermarkTextBox}"
                                 Text="{Binding SearchRacks, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center"/>

                        <Popup x:Name="RackPopup"
                               PlacementTarget="{Binding ElementName=SearchRack}" 
                               IsOpen="{Binding IsRackPopupOpen}"
                               Placement="Bottom" 
                               AllowsTransparency="True"
                               StaysOpen="True"
                               HorizontalOffset="0"
                               VerticalOffset="2">

                            <Border Background="White" 
                                    BorderBrush="#DDD" 
                                    BorderThickness="1" 
                                    Width="{Binding ElementName=SearchRack, Path=ActualWidth}">
                                
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                                </Border.Effect>

                                <ListBox ItemsSource="{Binding FilteredRacks}"
                                            BorderThickness="0"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="5">
                                                <TextBlock Text="{Binding CodeDisplay}" FontSize="14" VerticalAlignment="Bottom"/>
                                                <Button Content="Выбрать"
                                                        Command="{Binding DataContext.SetRackFromListCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>

                        <TextBlock Grid.Column="2" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Text="Ячейка" 
                                   Foreground="White" 
                                   FontSize="15"/>

                        <TextBox x:Name="SearchCell"
                                 Grid.Column="3"
                                 GotKeyboardFocus="SearchCell_GotKeyboardFocus"
                                 PreviewKeyDown="SearchCell_PreviewKeyDown"
                                 Margin="5"
                                 IsTabStop="False"
                                 Style="{StaticResource WatermarkTextBox}"
                                 Text="{Binding SearchCell, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center"/>

                        <Popup x:Name="CellPopup"
                               PlacementTarget="{Binding ElementName=SearchCell}" 
                               IsOpen="{Binding IsCellPopupOpen}"
                               Placement="Bottom" 
                               AllowsTransparency="True"
                               StaysOpen="True"
                               HorizontalOffset="0"
                               VerticalOffset="2">

                            <Border Background="White" 
                                    BorderBrush="#DDD" 
                                    BorderThickness="1" 
                                    Width="{Binding ElementName=SearchCell, Path=ActualWidth}">
                                
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                                </Border.Effect>

                                <ListBox ItemsSource="{Binding FilteredCells}"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="5">
                                                <TextBlock Text="{Binding CodeDisplay}" FontSize="14" VerticalAlignment="Bottom"/>
                                                <Button Content="Выбрать"
                                                    Command="{Binding DataContext.SetCellFromListCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, 
                                                                    Path=IsMouseOver}" 
                                                                    Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                
                            </Border>
                        </Popup>

                        <TextBlock Grid.Column="4" 
                                   Margin="2" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Text="Количество" 
                                   Foreground="White" 
                                   FontSize="15"/>
                        
                        <xctk:IntegerUpDown Grid.Column="5"
                                            Value="{Binding ReceiptItem.OperationQuantity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            Minimum="0"
                                            Margin="5"
                                            FontSize="15"
                                            TextAlignment="Center"
                                            ButtonSpinnerWidth="35">
                        </xctk:IntegerUpDown>
                        


                    </Grid>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="ФИО оператора" 
                               Foreground="White"
                               FontSize="15" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              ItemsSource="{Binding Operators}"
                              SelectedItem="{Binding OperatorName}"
                              DisplayMemberPath="FullName"
                              FontSize="20"
                              HorizontalContentAlignment="Center" 
                              VerticalContentAlignment="Center"
                              Margin="5"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Комментарий" 
                               Foreground="White"
                               FontSize="15" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Row="2"
                             Grid.Column="1" 
                             Text="{Binding CommentText}"
                             AcceptsReturn="True" 
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource TextBoxStyle}"
                             Margin="5"/>

                </Grid>

                <Button Grid.Row="1" 
                        Grid.ColumnSpan="2"
                        Command="{Binding ReceiveCommand}"
                        Content="Приёмка" 
                        Margin="0,5,5,5"/>

            </Grid>

        </Grid>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>

            <local:RacksGridControl x:Name="RacksGrid"
                                    Grid.Row="0"
                                    Racks="{Binding Racks}" />

            <local:CellsGridControl Grid.Row="1"
                                    Cells="{Binding Cells}"
                                    RackType="{Binding SelectedRack.Type, Mode=OneWay, FallbackValue=RackType1, TargetNullValue=RackType1}"
                                    SelectedCell="{Binding SelectedCell}"/>

        </Grid>

    </Grid>
</UserControl>
