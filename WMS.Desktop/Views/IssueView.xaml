<UserControl x:Class="WMS.Desktop.Views.IssueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views" 
             xmlns:viewmodels="clr-namespace:WMS.Desktop.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:IssueViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2"
                Text="Список остатков" FontSize="40" Foreground="White"/>
        </Grid>

        <Grid Grid.Row="1">

            <TextBox Grid.Column="0" Margin="2"
                    Style="{StaticResource WatermarkTextBox}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

        </Grid>

        <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding FilteredStockItemDto}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" />
                    <DataGridTextColumn Header="Название" Binding="{Binding ComponentName}" />
                    <DataGridTextColumn Header="Ячейка" Binding="{Binding CellCode}" />
                    <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}" />

                <!-- Кнопка -->
                    <DataGridTemplateColumn Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Добавить к выдаче"
                                    Command="{Binding DataContext.AddStockToIssueCommand, 
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <!-- По умолчанию кнопка скрыта -->
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <!-- Обращаемся к строке DataGridRow -->
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, 
                                                    Path=IsMouseOver}" 
                                                    Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="3">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2"
            Text="К выдаче" FontSize="40" Foreground="White"/>
        </Grid>
        
        <Grid Grid.Row="4">

            <DataGrid>
                
            </DataGrid>
            
        </Grid>

    </Grid>
</UserControl>
