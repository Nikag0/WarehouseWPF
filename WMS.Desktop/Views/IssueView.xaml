<UserControl x:Class="WMS.Desktop.Views.IssueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views" 
             xmlns:converters="clr-namespace:WMS.Desktop.Converters"
             xmlns:viewmodels="clr-namespace:WMS.Desktop.ViewModels" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             d:DataContext="{d:DesignInstance Type=viewmodels:IssueViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920">

    <UserControl.Resources>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:RackHighlightConverter x:Key="RackHighlightConverter"/>
    </UserControl.Resources>
    
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1000"/>
            <ColumnDefinition Width="920"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0"
              Margin="10,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <TextBlock 
                Text="Поиск для выдачи"
                FontSize="30"
                Foreground="White"
                HorizontalAlignment="Left" 
                VerticalAlignment="Center"/>
                
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,10">

                <TextBox Grid.Column="0"
                         x:Name="SearchIssue" 
                         IsTabStop="False"
                         Style="{StaticResource WatermarkTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <Popup PlacementTarget="{Binding ElementName=SearchIssue}" 
                   Placement="Bottom" 
                   AllowsTransparency="True"
                   StaysOpen="False"
                   HorizontalOffset="0"
                   VerticalOffset="2"
                   Style="{StaticResource FilterIssuePopupStyle}">

                    <Border Background="White" 
                        BorderBrush="#DDD" 
                        BorderThickness="1" 
                        Width="{Binding ElementName=SearchIssue, Path=ActualWidth}">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                        </Border.Effect>

                        <ListBox ItemsSource="{Binding FilteredStocks}"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            Background="#CCC">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock Text="Название: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding ComponentName}" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="  Артикул: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding Article}" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="  Производительт: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding Manufacturer}" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="  Ячейка: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding CellCode}" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="    " FontSize="14" VerticalAlignment="Bottom"/>
                                        <Button Content="Добавить к выдаче"
                                            Command="{Binding DataContext.AddIssueItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
                
            </Grid>

            <Grid Grid.Row="2">

                <DataGrid x:Name="IssueGrid" 
                          ItemsSource="{Binding IssueItems}" 
                          AutoGenerateColumns="False" 
                          FontSize="15">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Артикул" Width="100*" Binding="{Binding Article}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Название" Width="250*" Binding="{Binding ComponentName}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Производитель" Width="250*" Binding="{Binding Manufacturer}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Ячейка" Binding="{Binding CellCode}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}" IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="К выдаче">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <xctk:IntegerUpDown Value="{Binding IssueQuantity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="75">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Удалить"
                                            Command="{Binding DataContext.RemoveIssueItemCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Height="20"
                                            FontSize="12">
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>

            <Grid Grid.Row="3">

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0"
                      Margin="0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                               Text="Комментарий&#x0a;к выдаче"
                               Foreground="White"
                               FontSize="15"
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             AcceptsReturn="True" 
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="ФИО оператора" 
                               Foreground="White"
                               FontSize="15" 
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Users}"
                              DisplayMemberPath="FullName"
                              FontSize="20"
                              HorizontalContentAlignment="Center" 
                              VerticalContentAlignment="Center"/>

                    <Button Grid.Column="2"
                            Content="Выдать" 
                            Command="{Binding IssueCommand}"
                            FontSize="20"
                            Margin="10,0,0,0"/>

                </Grid>

            </Grid>

        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="600"/>
                <RowDefinition Height="480"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Image Source="/Images/Warehouse.png" 
                        Width="640" 
                        Height="600"/>
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="110"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Row="1" 
                               Grid.Column="1" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=A-1}"/>

                    <Rectangle Grid.Row="1" 
                               Grid.Column="2" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=A-2}"/>

                    <Rectangle Grid.Row="1" 
                               Grid.Column="3" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=A-3}"/>
                    
                    <Rectangle Grid.Row="3" 
                               Grid.Column="1" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=B-1}"/>
                    
                    <Rectangle Grid.Row="3" 
                               Grid.Column="2" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=B-2}"/>
                    
                    <Rectangle Grid.Row="3" 
                               Grid.Column="3" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=B-3}"/>
                    
                    <Rectangle Grid.Row="5" 
                               Grid.Column="1" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=C-1}"/>
                    
                    <Rectangle Grid.Row="5" 
                               Grid.Column="2" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=C-2}"/>
                    
                    <Rectangle Grid.Row="5" 
                               Grid.Column="3" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=C-3}"/>
                    
                    <Rectangle Grid.Row="6" 
                               Grid.Column="1" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=D-1}"/>
                    
                    <Rectangle Grid.Row="6" 
                               Grid.Column="2" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=D-2}"/>
                    
                    <Rectangle Grid.Row="6" 
                               Grid.Column="3" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=D-3}"/>
                    
                    <Rectangle Grid.Row="8" 
                               Grid.Column="1" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=E-1}"/>
                    
                    <Rectangle Grid.Row="8" 
                               Grid.Column="2" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=E-2}"/>
                    
                    <Rectangle Grid.Row="8" 
                               Grid.Column="3" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=E-3}"/>
                    
                    <Rectangle Grid.Row="8" 
                               Grid.Column="4" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=E-4}"/>

                </Grid>

            </Grid>

            <Grid Grid.Row="1">

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Image Source="/Images/Row1.jpg" 
                           Width="210" 
                           Height="350"/>
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="47"/>
                        <RowDefinition Height="47"/>
                        <RowDefinition Height="47"/>
                        <RowDefinition Height="47"/>
                        <RowDefinition Height="47"/>
                        <RowDefinition Height="47"/>
                        <RowDefinition Height="47"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="51"/>
                        <ColumnDefinition Width="51"/>
                        <ColumnDefinition Width="51"/>
                        <ColumnDefinition Width="51"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Row="1" 
                               Grid.Column="1" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=A-1-1-1}"/>
                    
                    <Rectangle Grid.Row="2" 
                               Grid.Column="1" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=A-1-2-1}"/>
                    
                    <Rectangle Grid.Row="2" 
                               Grid.Column="2" 
                               Stroke="Gray" 
                               StrokeThickness="1"
                               Fill="{Binding IssueItems, 
                               Converter={StaticResource RackHighlightConverter}, 
                               ConverterParameter=A-1-2-2}"/>

                   
                   
                </Grid>

            </Grid>
        </Grid>

    </Grid>
    
</UserControl>
