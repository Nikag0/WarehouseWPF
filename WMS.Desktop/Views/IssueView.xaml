<UserControl x:Class="WMS.Desktop.Views.IssueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views" 
             xmlns:converters="clr-namespace:WMS.Desktop.Converters"
             xmlns:viewmodels="clr-namespace:WMS.Desktop.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:IssueViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920">


    <UserControl.Resources>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:GreaterThanZeroConverter x:Key="GreaterThanZero"/>
    </UserControl.Resources>
    
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2"
                Text="Поиск для выдачи" FontSize="30" Foreground="White"/>
        </Grid>

        <Grid Grid.Row="1">

            <TextBox x:Name="SearchInput" Grid.Column="0" Margin="10" IsTabStop="False"
                    Style="{StaticResource WatermarkTextBox}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <Popup PlacementTarget="{Binding ElementName=SearchInput}" 
                       Placement="Bottom" 
                       AllowsTransparency="True"
                       StaysOpen="False"
                       HorizontalOffset="0"
                       VerticalOffset="2">

                <Popup.Style>
                    <Style TargetType="Popup">
                        <Setter Property="IsOpen" Value="False"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>

                                    <!-- Есть введённый текст -->
                                    <Condition Binding="{Binding ElementName=SearchInput, Path=Text.Length,
                                          Converter={StaticResource GreaterThanZero}}"
                                        Value="True"/>

                                    <!-- Есть результаты -->
                                    <Condition Binding="{Binding FilteredStocks.Count,
                                          Converter={StaticResource GreaterThanZero}}"
                                        Value="True"/>

                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsOpen" Value="True"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Popup.Style>

                <!-- Border задает ширину, как у TextBox -->
                <Border Background="White" 
                BorderBrush="#DDD" 
                BorderThickness="1" 
                Width="{Binding ElementName=SearchInput, Path=ActualWidth}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                    </Border.Effect>

                    <ListBox ItemsSource="{Binding FilteredStocks}"
                        BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <TextBlock Text="Название: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding ComponentName}" FontSize="14" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="  Артикул: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding Article}" FontSize="14" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="  Производительт: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding Manufacturer}" FontSize="14" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="  Ячейка: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding CellCode}" FontSize="14" VerticalAlignment="Bottom"/>
                                    <Button Content="Добавить к выдаче"
                                        Command="{Binding DataContext.AddSelectedStockCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, 
                                                        Path=IsMouseOver}" 
                                                        Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>

        <Grid Grid.Row="2">

            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="250*"/>
                    <ColumnDefinition Width="250*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="ФИО оператора" FontSize="15" Foreground="White"/>

                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Криворуков П.О." FontSize="18" Foreground="White" Background="DimGray"/>
                
                <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Дата выдачи" FontSize="15" Foreground="White"/>

                <TextBlock Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="22.22.2022" FontSize="18" Foreground="White" Background="DimGray"/>

                <TextBlock Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Text="Комментарйи к выдаче" FontSize="15" Foreground="White"/>

                <TextBox Grid.Column="5" Margin="5"/>
                
                <Button Grid.Column="6" 
                    Content="Выдать" FontSize="20" Margin="30,5"
                    Command="{Binding IssueCommand}"/>
            </Grid>

        </Grid>

        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <DataGrid ItemsSource="{Binding IssueItems}" AutoGenerateColumns="False" FontSize="15">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" />
                    <DataGridTextColumn Header="Название" Binding="{Binding ComponentName}" />
                    <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" />
                    <DataGridTextColumn Header="Ячейка" Binding="{Binding CellCode}" />
                    <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}" />
                    <DataGridTextColumn Header="" Width="40"/>
                    <DataGridTextColumn Header="К выдаче" Binding="{Binding IssueQuantity}" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
