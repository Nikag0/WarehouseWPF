<UserControl x:Class="WMS.Desktop.Views.IssueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views" 
             xmlns:converters="clr-namespace:WMS.Desktop.Converters"
             xmlns:viewmodels="clr-namespace:WMS.Desktop.ViewModels" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             d:DataContext="{d:DesignInstance Type=viewmodels:IssueViewModel}"
             mc:Ignorable="d" 
             d:DesignWidth="1920"
             d:DesignHeight="1008"
             PreviewMouseDown="Root_PreviewMouseDown">
            

    <UserControl.Resources>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0"
              Margin="10,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <TextBlock 
                    Text="Поиск для выдачи"
                    FontSize="30"
                    Foreground="White"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center"/>

            </Grid>

            <Grid x:Name="SearchToIssueGrid" 
                  Grid.Row="1"
                  Margin="0,10">

                <TextBox x:Name="SearchToIssue" 
                         GotKeyboardFocus="SearchToIssue_GotKeyboardFocus"
                         PreviewKeyDown="SearchToIssue_PreviewKeyDown"
                         Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         IsTabStop="False">

                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource WatermarkTextBox}">
                            <Setter Property="IsEnabled" Value="True"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIssue}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>

                        </Style>
                    </TextBox.Style>

                </TextBox>

                <Popup x:Name="IssuePopup"
                       PlacementTarget="{Binding ElementName=SearchToIssue}" 
                       IsOpen="{Binding IsIssuePopupOpen}"
                       Placement="Bottom" 
                       AllowsTransparency="True"
                       StaysOpen="True"
                       HorizontalOffset="0"
                       VerticalOffset="2">

                    <Border Background="White" 
                        BorderBrush="#DDD" 
                        BorderThickness="1" 
                        Width="{Binding ElementName=SearchToIssue, Path=ActualWidth}">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                        </Border.Effect>

                        <ListBox ItemsSource="{Binding FilteredStocks}"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Background="#CCC">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock Text="Название: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding ComponentName}" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="  Артикул: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding Article}" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="  Производительт: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding Manufacturer}" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="  Стеллаж: " Foreground="Gray" FontSize="11" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding RackCodeDisplay}" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="    Ячейка" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding CellCodeDisplay}" FontSize="14" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="    " FontSize="14" VerticalAlignment="Bottom"/>
                                        <Button Content="Добавить к выдаче"
                                                Command="{Binding DataContext.AddIssueItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}">
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

            </Grid>

            <Grid Grid.Row="2">

                <DataGrid x:Name="IssueGrid" 
                          ItemsSource="{Binding IssueItems}" 
                          AutoGenerateColumns="False" 
                          FontSize="15">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Артикул" Width="100*" Binding="{Binding Article}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Название" Width="250*" Binding="{Binding ComponentName}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Производитель" Width="250*" Binding="{Binding Manufacturer}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Стеллаж" Binding="{Binding RackCodeDisplay}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Ячейка" Binding="{Binding CellCodeDisplay}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}" IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="К выдаче">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <xctk:IntegerUpDown Value="{Binding OperationQuantity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                        <xctk:IntegerUpDown.Style>
                                            <Style TargetType="xctk:IntegerUpDown">
                                                <Setter Property="IsEnabled" Value="True"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsIssue, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </xctk:IntegerUpDown.Style>
                                    </xctk:IntegerUpDown>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="75">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Удалить"
                                            Command="{Binding DataContext.RemoveIssueItemCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Height="20"
                                            FontSize="12">

                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="IsEnabled" Value="True"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsIssue, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>


                <Button Content="Очистить список выдачи"
                        Command="{Binding ClearIssueItemsCommand}"
                        FontSize="20"
                        Height="50"
                        VerticalAlignment="Bottom"
                        Margin="10"
                        Foreground="White"
                        Background="#4FC3F7">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIssue}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </Grid>

            <Grid Grid.Row="3">

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIssue}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid Grid.Row="0"
                      Margin="0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Комментарий&#x0a;к выдаче"
                               Foreground="White"
                               FontSize="15"
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding CommentText}"
                             AcceptsReturn="True" 
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource TextBoxStyle}"/>

                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="ФИО оператора" 
                               Foreground="White"
                               FontSize="15" 
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Center"/>

                    <ComboBox x:Name="OperatorCompobox"
                              Grid.Column="1"
                              ItemsSource="{Binding Operators}"
                              SelectedItem="{Binding OperatorName}"
                              DisplayMemberPath="FullName"
                              FontSize="20"
                              HorizontalContentAlignment="Center" 
                              VerticalContentAlignment="Center"/>

                    <Button Grid.Column="2"
                            Content="Выдать" 
                            Command="{Binding IssueCommand}"
                            FontSize="20"
                            Margin="10,0,0,0"/>

                </Grid>

            </Grid>

        </Grid>

        <Grid Grid.Column="1">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>

            <local:RacksGridControl x:Name="RacksGrid"
                        Grid.Row="0"/>

            <local:CellsGridControl Grid.Row="1"/>

        </Grid>

    </Grid>

</UserControl>
