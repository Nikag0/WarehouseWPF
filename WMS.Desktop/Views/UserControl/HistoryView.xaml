<UserControl x:Class="WMS.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views"
             mc:Ignorable="d" 
             d:DesignHeight="1008" d:DesignWidth="1920">

    <Grid Margin="10"
       Background="#36495b">

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="История операций"
                   Style="{StaticResource WindowNames}"/>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="49*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="15*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="15*"/>
                <ColumnDefinition Width="17*"/>
            </Grid.ColumnDefinitions>

            <TextBox 
                Grid.Column="0"
                Margin="0,5,0,5" 
                Tag="Поиск:"
                Style="{StaticResource SearchTextBox}"
                Text="{Binding SearchHistory, UpdateSourceTrigger=PropertyChanged}">
            </TextBox>

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Text="От:"
                Foreground="White"
                FontSize="20"/>

            <DatePicker
                Grid.Column="2"
                Margin="5,0,0,0"
                Height="50" 
                FontSize="20"
                VerticalContentAlignment="Center"
                HorizontalAlignment="Stretch"
                SelectedDate="{Binding DateFrom}">
            </DatePicker>

            <TextBlock
                Grid.Column="3"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Text="До:"
                Foreground="White"
                FontSize="20"/>

            <DatePicker
                Grid.Column="4"
                Margin="5,0,0,0"
                Height="50" 
                FontSize="20"
                VerticalContentAlignment="Center"
                HorizontalAlignment="Stretch"
                SelectedDate="{Binding DateTo}"/>


            <ComboBox Grid.Column="6"
                ItemsSource="{Binding Type}"
                Tag="Тип операции:"
                SelectedItem="{Binding SelectedOperationType}"
                Margin="0,5,5,5"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center">
            </ComboBox>

        </Grid>

        <Grid Grid.Row="2"
              Width="300"
              HorizontalAlignment="Left"
              Margin="0,0,0,10">
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,5,0,0">
            
            <DataGrid ItemsSource="{Binding History}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      FontSize="15"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding OccurredAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="100*"/>
                    <DataGridTextColumn Header="Оператор" Binding="{Binding Operator}" Width="200*"/>
                    <DataGridTextColumn Header="Тип операции" Binding="{Binding Type}" Width="100*"/>
                    <DataGridTextColumn Header="Компонент" Binding="{Binding ComponentName}" Width="100*"/>
                    <DataGridTextColumn Header="Кол-во до" Binding="{Binding QuantityBefore}" Width="100*"/>
                    <DataGridTextColumn Header="Кол-во после" Binding="{Binding QuantityAfter}" Width="100*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
