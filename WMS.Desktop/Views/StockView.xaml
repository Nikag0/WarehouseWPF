<UserControl x:Class="WMS.Desktop.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" Margin="2" 
                      ItemsSource="{Binding Components}" SelectedValue="{Binding SelectedComponentId}" DisplayMemberPath="Name"/>
            <ComboBox Grid.Column="1" Margin="2"
                      ItemsSource="{Binding Cells}" SelectedValue="{Binding SelectedCellId}" DisplayMemberPath="Code"/>
            <TextBox Grid.Column="2" Margin="2" Text="{Binding Quantity}"/>
            <Button Grid.Column="3" Margin="2" Content="Приёмка" Command="{Binding ReceiveCommand}"/>
            <Button Grid.Column="4" Margin="2" Content="Обновить" Command="{Binding RefreshCommand}"/>
        </Grid>

        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding Stocks}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" />
                    <DataGridTextColumn Header="Название" Binding="{Binding ComponentName}" />
                    <DataGridTextColumn Header="Ячейка" Binding="{Binding CellCode}" />
                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
