<UserControl x:Class="WMS.Desktop.Views.RacksGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="20*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0"
          Grid.Column="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="21*"/>
                <ColumnDefinition Width="21*"/>
                <ColumnDefinition Width="29.5*"/>
                <ColumnDefinition Width="21*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1" Style="{StaticResource HeaderTextStyle}" Text="A"/>
            <TextBlock Grid.Column="2" Style="{StaticResource HeaderTextStyle}" Text="Б"/>
            <TextBlock Grid.Column="3" Style="{StaticResource HeaderTextStyle}" Text="В"/>
            <TextBlock Grid.Column="4" Style="{StaticResource HeaderTextStyle}" Text="Г"/>

        </Grid>

        <Grid Grid.Row="1"
          Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="17*"/>
                <RowDefinition Height="9.5*"/>
                <RowDefinition Height="5.5*"/>
                <RowDefinition Height="17*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="17*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="1" Style="{StaticResource HeaderTextStyle}" Text="1"/>
            <TextBlock Grid.Row="3" Style="{StaticResource HeaderTextStyle}" Text="2"/>
            <TextBlock Grid.Row="5" Style="{StaticResource HeaderTextStyle}" Text="3"/>
            <TextBlock Grid.Row="6" Style="{StaticResource HeaderTextStyle}" Text="4"/>
            <TextBlock Grid.Row="8" Style="{StaticResource HeaderTextStyle}" Text="5"/>

        </Grid>

        <Grid Grid.Row="1"
          Grid.Column="1">

            <Image Source="/Images/Warehouse.png" 
                Width="auto" 
                Height="auto"
                Stretch="Fill"/>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40*"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="50*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28*"/>
                        <ColumnDefinition Width="16.6*"/>
                        <ColumnDefinition Width="16.6*"/>
                        <ColumnDefinition Width="16.6*"/>
                        <ColumnDefinition Width="16.6*"/>
                        <ColumnDefinition Width="8.6*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1" Style="{StaticResource HeaderTextStyle}" Text="A"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource HeaderTextStyle}" Text="Б"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource HeaderTextStyle}" Text="В"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource HeaderTextStyle}" Text="Г"/>

                </Grid>

                <Grid Grid.Row="0"
                  Grid.RowSpan="4">

                    <ItemsControl ItemsSource="{Binding NormalVisibleRacks}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="10*"/>
                                        <RowDefinition Height="17*"/>
                                        <RowDefinition Height="10*"/>
                                        <RowDefinition Height="5.5*"/>
                                        <RowDefinition Height="17*"/>
                                        <RowDefinition Height="9.5*"/>
                                        <RowDefinition Height="17*"/>
                                        <RowDefinition Height="10*"/>
                                        <RowDefinition Height="1*"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6*"/>
                                        <ColumnDefinition Width="21*"/>
                                        <ColumnDefinition Width="21*"/>
                                        <ColumnDefinition Width="29.5*"/>
                                        <ColumnDefinition Width="21*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Setter Property="Grid.Column" Value="{Binding Column}"/>
                                <Setter Property="Grid.Row" Value="{Binding Row}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Gray"
                                        BorderThickness="1"
                                        MouseLeftButtonDown="RackBorder_MouseLeftButtonDown"
                                        Opacity="0.5">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedRack}" Value="True">
                                                    <Setter Property="Background" Value="Yellow"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </Grid>

                <Grid Grid.Row="1">

                    <ItemsControl ItemsSource="{Binding SpecialVisibleRacks}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28*"/>
                                        <ColumnDefinition Width="16.6*"/>
                                        <ColumnDefinition Width="16.6*"/>
                                        <ColumnDefinition Width="16.6*"/>
                                        <ColumnDefinition Width="16.6*"/>
                                        <ColumnDefinition Width="8.6*"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Setter Property="Grid.Column" Value="{Binding Column}"/>
                                <Setter Property="Grid.Row" Value="{Binding Row}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Gray"
                                        Opacity="0.5"
                                        BorderThickness="1"
                                        MouseLeftButtonDown="RackBorder_MouseLeftButtonDown">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedRack}" Value="True">
                                                    <Setter Property="Background" Value="Yellow"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </Grid>

                <!--<Grid Grid.Row="2" 
                    Grid.Column="5"
                    Margin="0,0,3,0">
                  <Rectangle 
                      Stroke="Gray" 
                      StrokeThickness="1"
                      Fill="LightGray" />

                    <TextBlock 
                        Text="👤" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        FontSize="20" 
                        Foreground="Black"/>
                </Grid>-->

            </Grid>

        </Grid>

    </Grid>
</UserControl>
