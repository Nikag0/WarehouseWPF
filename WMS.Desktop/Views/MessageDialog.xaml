<Window x:Class="WMS.Desktop.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" MinWidth="420" MaxWidth="560"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#36495b">
    <StackPanel Margin="16">
        <Border Background="#465E74" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IconText" FontFamily="Segoe MDL2 Assets"
                           FontSize="25" VerticalAlignment="Top" Margin="0,2,12,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="HeadingText" Foreground="White" FontWeight="SemiBold"
                               FontSize="{StaticResource EmphasisFontSize}" TextWrapping="Wrap"
                               Margin="0,0,0,6"/>
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="MessageText" Foreground="#EDF4FA" TextWrapping="Wrap"
                                   FontSize="{StaticResource BodyFontSize}" LineHeight="25" Margin="0,0,12,0"/>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="NoButton" IsCancel="True" MinWidth="110" MinHeight="42"
                    Margin="0,0,8,0" Background="#465E74" Foreground="White"
                    Style="{StaticResource ButtonStyle}"/>
            <Button x:Name="YesButton" IsDefault="True" Click="YesButton_Click"
                    MinWidth="110" MinHeight="42" Background="#E2EDF6" Foreground="#192D3D"
                    Style="{StaticResource ButtonStyle}"/>
            <Button x:Name="OkButton" Content="ОК" IsDefault="True" IsCancel="True"
                    Click="YesButton_Click" MinWidth="110" MinHeight="42"
                    Background="#E2EDF6" Foreground="#192D3D"
                    Style="{StaticResource ButtonStyle}"/>
        </StackPanel>
    </StackPanel>
</Window>
