<Window x:Class="WMS.Desktop.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        MaxWidth="500"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#36495b">

    <!-- Окно сообщений вместо стандартного MessageBox: у MessageBox системный мелкий шрифт, и его нельзя увеличить -->
    <Grid Margin="25,20,25,20">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Значок типа сообщения: символ шрифта Segoe MDL2 Assets, цвет задаётся в коде -->
        <TextBlock x:Name="IconText"
                   Grid.Row="0"
                   Grid.Column="0"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="40"
                   VerticalAlignment="Top"
                   Margin="0,2,20,0"/>

        <ScrollViewer Grid.Row="0"
                      Grid.Column="1"
                      MaxHeight="500"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <TextBlock x:Name="MessageText"
                       FontSize="{StaticResource EmphasisFontSize}"
                       Foreground="White"
                       TextWrapping="Wrap"
                       LineHeight="28"/>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,25,0,0">

            <Button x:Name="YesButton"
                    Content="Да"
                    IsDefault="True"
                    Click="YesButton_Click"
                    MinWidth="130"
                    Height="45"
                    FontSize="{StaticResource BodyFontSize}"
                    Margin="0,0,10,0"
                    Style="{StaticResource ButtonStyle}"/>

            <Button x:Name="NoButton"
                    Content="Нет"
                    IsCancel="True"
                    MinWidth="130"
                    Height="45"
                    FontSize="{StaticResource BodyFontSize}"
                    Style="{StaticResource ButtonStyle}"/>

            <Button x:Name="OkButton"
                    Content="ОК"
                    IsDefault="True"
                    IsCancel="True"
                    Click="YesButton_Click"
                    MinWidth="130"
                    Height="45"
                    FontSize="{StaticResource BodyFontSize}"
                    Style="{StaticResource ButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
