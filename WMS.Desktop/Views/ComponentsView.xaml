<UserControl x:Class="WMS.Desktop.Views.ComponentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views" 
             xmlns:viewmodels="clr-namespace:WMS.Desktop.ViewModels" 
             
             d:DataContext="{d:DesignInstance Type=viewmodels:ComponentsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="1008" d:DesignWidth="1920">


    <Grid Margin="10,0"
          Background="#36495b">

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Каталог товаров"
                   Style="{StaticResource WindowNames}"
                   Margin="0,0,0,10"/>

        <TextBox Grid.Row="1"
                 Margin="0,0,0,10" 
                 Tag="Поиск:"
                 Style="{StaticResource SearchTextBox}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

        <Grid Grid.Row="2"
              Width="300"
              HorizontalAlignment="Left"
              Margin="0,0,0,10">
            
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAdding}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,0,0,10">

            <DataGrid ItemsSource="{Binding FilteredComponents}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      FontSize="15"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="150*"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="400*"/>
                    <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="300*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </Grid>
    
</UserControl>
