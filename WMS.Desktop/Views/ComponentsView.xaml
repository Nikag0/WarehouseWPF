<UserControl x:Class="WMS.Desktop.Views.ComponentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WMS.Desktop.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
      <DockPanel Margin="10">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Артикул"/>
            <TextBox Width="100" Text="{Binding NewArticle}"/>
            <TextBlock Text="Название"/>
            <TextBox Width="200" Margin="5,0" Text="{Binding NewName}"/>
            <Button Content="Добавить" Command="{Binding AddCommand}" />
            <Button Content="Обновить" Margin="5,0" Command="{Binding LoadCommand}" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Components}" AutoGenerateColumns="True"/>
    </DockPanel>

</UserControl>
