<Window x:Class="WMS.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WMS.Desktop.Views" 
        xmlns:viewmodels="clr-namespace:WMS.Desktop.ViewModels" 
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        d:DesignHeight="1008" 
        d:DesignWidth="1920"
        MinHeight="700"
        MinWidth="1500"
        WindowState="Maximized">
    <!-- Высота 1008, потому что 40 пикселей нижнее меню, 32 верхняя плашка-->

    <TabControl Grid.Column="0"
                ItemContainerStyle="{StaticResource MenuTabItemStyle}"
                TabStripPlacement="Left"
                Background="#36495b"
                VirtualizingStackPanel.IsVirtualizing="False">

        <TabItem>
            <TabItem.Header>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="✉️" FontSize="22" HorizontalAlignment="Center"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    <TextBlock Text="Сообщения" FontSize="11" HorizontalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                </StackPanel>
            </TabItem.Header>

        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📑" FontSize="22" HorizontalAlignment="Center"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    <TextBlock Text="Каталог" FontSize="11" HorizontalAlignment="Center"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                </StackPanel>
            </TabItem.Header>

            <views:ComponentsView DataContext="{Binding Components}"/>

        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Выдача" FontSize="11"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>

            <views:IssueView DataContext="{Binding Issue}"/>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📥" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Приёмка" FontSize="11"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>

            <views:ReceiptView DataContext="{Binding Receipt}"/>

        </TabItem>

        <TabItem >
            <TabItem.Header>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Настройки" FontSize="11"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>

        </TabItem>

    </TabControl>
    
</Window>
