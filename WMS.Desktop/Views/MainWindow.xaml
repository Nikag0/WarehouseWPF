<Window x:Class="WMS.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WMS.Desktop.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <TabControl>
            <!-- Вкладка 1: Справочник компонентов -->
            <TabItem Header="Components">
                <views:ComponentsView DataContext="{Binding Components}"/>
            </TabItem>

            <!-- Вкладка 2: Остатки -->
            <TabItem Header="Stock">
                <views:StockView DataContext="{Binding Stocks}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
